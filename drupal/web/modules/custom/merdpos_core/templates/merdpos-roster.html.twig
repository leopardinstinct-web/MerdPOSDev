{#
  Roster planner surface.

  The grid is rendered server-side on purpose: when the browser goes offline, the
  week it already has IS the last confirmed week, so it stays readable with no
  fetch at all. Everything the planner changes is queued locally and replayed
  through /merdpos/roster/submit, where the portal remains authoritative.

  No |raw anywhere: every value is escaped by Twig.
#}
<section class="merdpos-app merdpos-roster"
         aria-label="Roster planner"
         data-roster-offline-root
         data-roster-queue-key="{{ surface.write.queue_key }}"
         data-roster-cache-key="{{ surface.write.cache_key }}"
         data-roster-submit-url="{{ surface.write.submit_url }}"
         data-roster-token="{{ surface.write.form_token }}"
         data-roster-store-id="{{ surface.store.id }}"
         data-roster-week-start="{{ surface.week_start }}"
         data-roster-week-status="{{ surface.week.status }}"
         data-roster-can-manage="{{ surface.can_manage ? '1' : '0' }}"
         data-roster-status="{{ surface.status }}">

  <header class="merdpos-page-header merdpos-roster-hero">
    <div class="merdpos-page-header__copy">
      <p class="merdpos-page-header__eyebrow">Roster</p>
      <h1 class="merdpos-page-header__title">{{ surface.title }}</h1>
      <p class="merdpos-page-header__description">{{ surface.description }}</p>
    </div>
    <div class="merdpos-roster-state" aria-live="polite">
      <span class="merdpos-roster-status" data-status="{{ surface.status|lower }}">{{ surface.status_label }}</span>
      <span class="merdpos-roster-queue-pill" data-roster-queue-badge>✓ Up to date</span>
      <span class="merdpos-roster-queue-message" data-roster-status-message></span>
    </div>
  </header>

  <form class="merdpos-roster-filters" method="get" aria-label="Roster week and store">
    <label>
      <span>Store</span>
      <select name="store_id" data-roster-store>
        {% for store in surface.stores %}
          <option value="{{ store.id }}"{{ store.selected ? ' selected' : '' }}>{{ store.name }}</option>
        {% else %}
          <option value="0">No store available</option>
        {% endfor %}
      </select>
    </label>
    <label>
      <span>Week starting (Monday)</span>
      <select name="week_start" data-roster-week>
        {% for week in surface.week_options %}
          <option value="{{ week.value }}"{{ week.selected ? ' selected' : '' }}>{{ week.label }}</option>
        {% endfor %}
      </select>
    </label>
    <button class="merdpos-btn merdpos-btn--primary" type="submit">Show week</button>
    <span class="merdpos-roster-permission">{{ surface.permission_message }}</span>
  </form>

  {% if surface.status != 'ok' %}
    <div class="merdpos-roster-notice" role="status">
      <strong>Roster unavailable</strong>
      <p>MERDPOS did not return this week. The planner stays read-only until it does; nothing you enter here is lost, it queues on this device.</p>
    </div>
  {% endif %}

  <section class="merdpos-roster-board" aria-label="Planned week">
    <header class="merdpos-roster-board-head">
      <div>
        <p class="merdpos-eyebrow">PLANNED WEEK</p>
        <h2>{{ surface.store.name }}{% if surface.week_label %} · {{ surface.week_label }}{% endif %}</h2>
      </div>
      <div class="merdpos-roster-board-meta">
        <span>Status: {{ surface.week.status|capitalize }}</span>
        <span>{{ surface.slots.early.label }} {{ surface.slots.early.start }}–{{ surface.slots.early.end }}</span>
        <span>{{ surface.slots.late.label }} {{ surface.slots.late.start }}–{{ surface.slots.late.end }}</span>
      </div>
    </header>

    <div class="merdpos-roster-grid" role="table" aria-label="Week grid">
      <div class="merdpos-roster-grid-head" role="row">
        <span role="columnheader">Shift</span>
        {% for day in surface.week_days %}
          <span role="columnheader" class="merdpos-roster-dayhead{{ day.is_today ? ' is-today' : '' }}">
            <strong>{{ day.weekday }}</strong><small>{{ day.day }}</small>
          </span>
        {% endfor %}
      </div>

      {% for slot_key, slot in surface.slots %}
        <div class="merdpos-roster-grid-row" role="row">
          <span class="merdpos-roster-slot" role="rowheader">
            <strong>{{ slot.label }}</strong><small>{{ slot.start }}–{{ slot.end }}</small>
          </span>
          {% for day in surface.week_days %}
            {% set key = day.date ~ '|' ~ slot_key %}
            {% set shift = surface.shifts[key] ?? null %}
            <div class="merdpos-roster-cell{{ day.is_today ? ' is-today' : '' }}{{ shift ? '' : ' is-empty' }}"
                 role="cell"
                 data-roster-cell="{{ key }}"
                 data-roster-date="{{ day.date }}"
                 data-roster-slot="{{ slot_key }}">
              <div class="merdpos-roster-cell-head">
                <label class="merdpos-roster-time">
                  <span class="merdpos-visually-hidden">Start</span>
                  <input type="time" value="{{ shift ? shift.start_time : slot.start }}" data-roster-start{{ surface.can_manage ? '' : ' disabled' }}>
                </label>
                <label class="merdpos-roster-time">
                  <span class="merdpos-visually-hidden">End</span>
                  <input type="time" value="{{ shift ? shift.end_time : slot.end }}" data-roster-end{{ surface.can_manage ? '' : ' disabled' }}>
                </label>
                <label class="merdpos-roster-nextday" title="Ends next day">
                  <input type="checkbox" data-roster-ends-next-day{{ shift and shift.ends_next_day ? ' checked' : '' }}{{ surface.can_manage ? '' : ' disabled' }}>
                  <span aria-hidden="true">+1d</span>
                  <span class="merdpos-visually-hidden">Ends the next day</span>
                </label>
              </div>
              <ul class="merdpos-roster-assignments" data-roster-assignments>
                {% for assignment in shift ? shift.assignments : [] %}
                  <li class="merdpos-roster-chip" data-roster-employee="{{ assignment.employee_id }}">
                    <span>{{ assignment.name }}</span>
                    {% if surface.can_manage %}
                      <button type="button" class="merdpos-roster-chip-remove" data-roster-remove aria-label="Remove {{ assignment.name }}">×</button>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
              {% if surface.can_manage %}
                <div class="merdpos-roster-add">
                  <label>
                    <span class="merdpos-visually-hidden">Add employee</span>
                    <select data-roster-add>
                      <option value="">Add employee…</option>
                      {% for employee in surface.employees %}
                        <option value="{{ employee.id }}">{{ employee.name }}</option>
                      {% endfor %}
                    </select>
                  </label>
                  {% if surface.employees is empty %}
                    <small class="merdpos-roster-hint">
                      {% if surface.employee_scope == 'ok' %}No employee may work at this store yet.
                      {% else %}The assignable employee list is unavailable; shifts still queue and the portal validates them.{% endif %}
                    </small>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </section>

  {% if surface.can_manage %}
    <section class="merdpos-roster-actions" aria-label="Publish">
      <label class="merdpos-roster-note">
        <span>Note for the week</span>
        <input type="text" maxlength="255" value="{{ surface.week.note }}" data-roster-note placeholder="Optional note (for example: Rose Bay early start 06:00)">
      </label>
      <div class="merdpos-roster-action-buttons">
        <button type="button" class="merdpos-btn" data-roster-save="draft">Save draft</button>
        <button type="button" class="merdpos-btn merdpos-btn--primary" data-roster-save="published">Publish week</button>
      </div>
      <p class="merdpos-roster-hint">Saved on this device first, then sent to MERDPOS. A queued week keeps its submission ID, so retrying after a dropped connection cannot double-apply it.</p>
    </section>
  {% endif %}

  <p class="merdpos-roster-offline-note" data-roster-offline-note hidden>Offline — showing the last confirmed week from this device plus changes waiting to sync.</p>
</section>
