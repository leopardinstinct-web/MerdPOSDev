<section class="merdpos-finance-v2" aria-label="Financial command centre" data-finance-offline-root data-finance-queue-key="{{ surface.write.queue_key }}" data-finance-submit-url="{{ surface.write.submit_url }}" data-finance-token="{{ surface.write.form_token }}" data-finance-store-id="{{ surface.selected_store.id }}" data-finance-business-date="{{ surface.business_date }}" data-finance-day-status="{{ surface.day_status }}" data-finance-currency="{{ surface.currency }}">
  <header class="merdpos-page-header merdpos-finance-hero">
    <div class="merdpos-page-header__copy merdpos-finance-copy">
      <p class="merdpos-page-header__eyebrow merdpos-eyebrow">Financials</p>
      <h1 class="merdpos-page-header__title">{{ surface.title }}</h1>
      <p class="merdpos-page-header__description">{{ surface.description }}</p>
    </div>
  </header>

  <form class="merdpos-finance-filters" method="get" aria-label="Finance filters">
    <div class="merdpos-finance-filter-intro"><strong>Store & business date</strong><span>Authoritative financial statement selection</span></div>
    {% for filter in surface.filters %}
      <label>
        <span>{{ filter.label }}</span>
        {% if filter.type == 'select' %}
          <select name="{{ filter.name }}">
            {% for option in filter.options %}<option value="{{ option.value }}"{{ option.value == filter.value ? ' selected' : '' }}>{{ option.label }}</option>{% endfor %}
          </select>
        {% else %}
          <input type="{{ filter.type }}" name="{{ filter.name }}" value="{{ filter.value }}">
        {% endif %}
      </label>
    {% endfor %}
    <button class="merdpos-btn merdpos-btn--primary" type="submit">Apply</button>
    <div class="merdpos-finance-queue-state" aria-live="polite">
      <span class="merdpos-finance-queue-pill" data-finance-queue-badge>0 pending</span>
      <span class="merdpos-finance-queue-message" data-finance-status></span>
    </div>
  </form>

  <div class="merdpos-finance-kpis" aria-label="Finance summary">
    {% for metric in surface.metrics %}
      <article class="merdpos-finance-kpi merdpos-finance-kpi--{{ metric.tone }}">
        <span class="merdpos-finance-kpi-icon" aria-hidden="true">{% if loop.index == 1 %}↗{% elseif loop.index == 2 %}▣{% elseif loop.index == 3 %}◫{% elseif loop.index == 4 %}◉{% else %}≡{% endif %}</span>
        <div><small>{{ metric.label }}</small><strong>{{ metric.value }}</strong><span>{{ metric.meta }}</span></div>
      </article>
    {% endfor %}
  </div>

  {% if surface.exceptions %}
    <aside class="merdpos-finance-alerts" aria-label="Financial attention">
      <div><strong>Attention</strong><span>Authoritative status conditions for this view</span></div>
      <ul>{% for item in surface.exceptions %}<li>{{ item }}</li>{% endfor %}</ul>
    </aside>
  {% endif %}

  <div class="merdpos-finance-charts">
    {% if charts.finance_sales_trend %}<article class="merdpos-finance-chart-card merdpos-finance-chart-card--wide"><header><p>SALES TREND</p><h2>Completed sales</h2></header><div class="merdpos-finance-chart">{{ charts.finance_sales_trend }}</div></article>{% endif %}
    {% if charts.finance_sales_by_store %}<article class="merdpos-finance-chart-card"><header><p>STORE PERFORMANCE</p><h2>Sales by store</h2></header><div class="merdpos-finance-chart">{{ charts.finance_sales_by_store }}</div></article>{% endif %}
    {% if charts.finance_cash_mix %}<article class="merdpos-finance-chart-card"><header><p>CASH POSITION</p><h2>Register vs petty cash</h2></header><div class="merdpos-finance-chart">{{ charts.finance_cash_mix }}</div></article>{% endif %}
    {% if charts.finance_register_by_store %}<article class="merdpos-finance-chart-card"><header><p>REGISTER</p><h2>Register by store</h2></header><div class="merdpos-finance-chart">{{ charts.finance_register_by_store }}</div></article>{% endif %}
    {% if charts.finance_petty_by_store %}<article class="merdpos-finance-chart-card"><header><p>PETTY CASH</p><h2>Petty cash by store</h2></header><div class="merdpos-finance-chart">{{ charts.finance_petty_by_store }}</div></article>{% endif %}
  </div>

  <section class="merdpos-finance-panel">
    <header class="merdpos-finance-panel-head">
      <div><p>SELECTED STORE</p><h2>{{ surface.selected_store.name ?: 'Financial day accounts' }}</h2></div>
      <div class="merdpos-finance-capabilities">
        <span>{{ surface.selected_store.can_cross_store ? 'Cross-store enabled' : 'Store-scoped' }}</span>
        <span>{{ surface.write.can_open_day ? 'Open-day permission' : 'Open-day restricted' }}</span>
        <span>{{ surface.write.can_submit ? 'Cash entry permission' : 'Cash entry restricted' }}</span>
      </div>
    </header>
    <div class="merdpos-finance-accounts">
      {% for account in surface.account_cards %}
        <article class="merdpos-finance-account" data-finance-account="{{ account.title }}" data-finance-available="{{ account.available_raw }}">
          <div class="merdpos-finance-account-head"><strong>{{ account.title }}</strong><span data-status="{{ account.status|lower }}">{{ account.status }}</span></div>
          <div class="merdpos-finance-account-balance"><small>Available</small><strong>{{ account.available }}</strong></div>
          <dl><div><dt>Opening</dt><dd>{{ account.opening }}</dd></div><div><dt>Cash IN</dt><dd>{{ account.in }}</dd></div><div><dt>Cash OUT</dt><dd>{{ account.out }}</dd></div><div><dt>Closing</dt><dd>{{ account.closing }}</dd></div></dl>
        </article>
      {% else %}
        <div class="merdpos-empty">No account statement returned for this store and date.</div>
      {% endfor %}
    </div>
  </section>

  <section class="merdpos-finance-panel merdpos-finance-actions" aria-label="Financial actions">
    <header class="merdpos-finance-panel-head">
      <div><p>AUTHORITATIVE ACTIONS</p><h2>Register & petty cash</h2></div>
      <div class="merdpos-finance-capabilities"><span>Signed MERDPOS write</span><span>Offline queue + idempotent submission ID</span></div>
    </header>
    {% if not surface.selected_store.id %}
      <div class="merdpos-empty">Choose an authorised store before submitting financials.</div>
    {% else %}
      {% if surface.day_status == 'not_open' %}
        {% if surface.write.can_open_day %}
          <form class="merdpos-finance-action-card" method="post" action="{{ surface.write.post_url }}" data-finance-queue-form data-finance-submission-type="open_day">
            <input type="hidden" name="form_token" value="{{ surface.write.form_token }}">
            <input type="hidden" name="finance_action" value="open_day">
            <input type="hidden" name="store_id" value="{{ surface.selected_store.id }}">
            <input type="hidden" name="business_date" value="{{ surface.business_date }}">
            <div class="merdpos-finance-action-copy"><p>OPEN DAY</p><h3>Opening balances</h3><span>An authorised actor confirms the starting Register and Petty Cash balances.</span></div>
            <div class="merdpos-finance-action-fields">
              <label><span>Register opening</span><input type="number" name="register_opening" min="0" step="0.01" required inputmode="decimal"></label>
              <label><span>Petty Cash opening</span><input type="number" name="petty_cash_opening" min="0" step="0.01" required inputmode="decimal"></label>
            </div>
            <button class="merdpos-btn merdpos-btn--primary" type="submit">Open financial day</button>
          </form>
        {% else %}
          <div class="merdpos-empty">This financial day has not been opened. MERDPOS requires finance.open_day permission to set the opening balances.</div>
        {% endif %}
      {% endif %}

      {% if surface.write.can_submit %}
        <div class="merdpos-finance-action-grid">
          <form class="merdpos-finance-action-card" method="post" action="{{ surface.write.post_url }}" data-finance-queue-form data-finance-submission-type="cash_movement">
            <input type="hidden" name="form_token" value="{{ surface.write.form_token }}">
            <input type="hidden" name="finance_action" value="cash_movement">
            <input type="hidden" name="store_id" value="{{ surface.selected_store.id }}">
            <input type="hidden" name="business_date" value="{{ surface.business_date }}">
            <div class="merdpos-finance-action-copy"><p>CASH MOVEMENT</p><h3>Cash IN / OUT</h3><span>Pending entries are included in the browser's effective available balance before reconnect.</span></div>
            <div class="merdpos-finance-action-fields">
              <label><span>Movement</span><select name="submission_type" required><option value="cash_in">Cash IN</option><option value="cash_out">Cash OUT</option></select></label>
              <label><span>Account</span><select name="account" required data-finance-cash-account><option value="Register">Register</option><option value="Petty Cash">Petty Cash</option></select></label>
              <div class="merdpos-finance-effective"><span>Available</span><strong data-finance-effective-available>Not opened</strong></div>
              <label class="is-wide"><span>Reason / head</span><input type="text" name="head" minlength="2" maxlength="120" required></label>
              <label><span>Amount</span><input type="number" name="amount" min="0.01" step="0.01" required inputmode="decimal"></label>
            </div>
            <button class="merdpos-btn merdpos-btn--primary" type="submit">Save cash movement</button>
          </form>

          <form class="merdpos-finance-action-card merdpos-finance-action-card--close" method="post" action="{{ surface.write.post_url }}" data-finance-queue-form data-finance-submission-type="z_report" data-finance-close-form>
            <input type="hidden" name="form_token" value="{{ surface.write.form_token }}">
            <input type="hidden" name="finance_action" value="z_report">
            <input type="hidden" name="store_id" value="{{ surface.selected_store.id }}">
            <input type="hidden" name="business_date" value="{{ surface.business_date }}">

            <div class="merdpos-finance-action-copy"><p>Z REPORT</p><h3>Close financial day</h3><span>This is a one-time close. A queued closing blocks later submissions for the same store/date until it syncs.</span></div>
            <div class="merdpos-finance-action-fields">
              <label><span>Register total</span><input type="number" name="register_total" min="0" step="0.01" required inputmode="decimal"></label>
              <label><span>Petty Cash add-in</span><input type="number" name="petty_cash_addin" min="0" step="0.01" value="0" inputmode="decimal"></label>
              <label class="is-wide"><span>Denominations (optional, comma separated)</span><input type="text" name="denominations" maxlength="2000"></label>
            </div>
            <button class="merdpos-btn merdpos-btn--danger" type="submit">Close financial day</button>
          </form>
        </div>
      {% elseif surface.day_status == 'open' %}
        <div class="merdpos-empty">You can view this financial day, but MERDPOS has not granted finance.submit permission for cash movements or closing.</div>
      {% endif %}
      {% if surface.day_status == 'closed' %}
        <div class="merdpos-empty">This financial day is closed. MERDPOS will reject any stale queued submission for this date; choose another business date for new activity.</div>
      {% endif %}
    {% endif %}
    <p class="merdpos-finance-offline-note">Financial submissions are first saved in this browser using the canonical MERDPOS queue and automatically retried when connectivity returns.</p>
  </section>

  <section class="merdpos-finance-table-card">
    <header><p>CROSS-STORE VIEW</p><h2>Store position</h2><span>Sales and cash balances returned by MERDPOS</span></header>
    <div class="merdpos-finance-table-wrap"><table><thead><tr><th>Store</th><th>Sales</th><th>Register</th><th>Petty cash</th></tr></thead><tbody>
      {% for row in surface.store_rows %}<tr><td>{{ row.store }}</td><td>{{ row.sales }}</td><td>{{ row.register }}</td><td>{{ row.petty }}</td></tr>{% else %}<tr><td colspan="4">No cross-store finance summary returned.</td></tr>{% endfor %}
    </tbody></table></div>
  </section>

  <section class="merdpos-finance-table-card">
    <header><p>LEDGER</p><h2>Selected store activity</h2><span>Latest {{ surface.ledger_rows|length }} entries for this business date</span></header>
    <div class="merdpos-finance-table-wrap"><table><thead><tr><th>Account</th><th>Type</th><th>Head</th><th>Amount</th><th>By</th><th>Time</th></tr></thead><tbody>
      {% for row in surface.ledger_rows %}<tr><td>{{ row.account }}</td><td><span class="merdpos-finance-entry-type">{{ row.type }}</span></td><td>{{ row.head }}</td><td>{{ row.amount }}</td><td>{{ row.by }}</td><td>{{ row.at }}</td></tr>{% else %}<tr><td colspan="6">No ledger entries returned.</td></tr>{% endfor %}
    </tbody></table></div>
  </section>

  <footer class="merdpos-finance-footer"><strong>Authoritative MERDPOS financials</strong><span>Drupal submits only whitelisted financial actions through the signed gateway. MERDPOS remains authoritative for permissions, store-attendance requirements, balances, close rules, idempotency, audit and outbox writes.</span></footer>
</section>