{% macro icon(name) %}
<svg viewBox="0 0 24 24" aria-hidden="true">
  {% if name == 'users' %}<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
  {% elseif name == 'message' %}<path d="M21 15a4 4 0 0 1-4 4H8l-5 3v-7a8 8 0 1 1 18 0Z"/><path d="M8 11h8M8 15h5"/>
  {% elseif name == 'sync' %}<path d="M20 7h-5V2"/><path d="M4 17h5v5"/><path d="M5.5 9a8 8 0 0 1 13-3L20 7"/><path d="M18.5 15a8 8 0 0 1-13 3L4 17"/>
  {% elseif name == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
  {% elseif name == 'store' %}<path d="M3 9l2-5h14l2 5"/><path d="M5 13v7h14v-7"/><path d="M9 20v-6h6v6"/><path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/>
  {% elseif name == 'wallet' %}<path d="M3 7h15a3 3 0 0 1 3 3v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M16 12h5v4h-5a2 2 0 0 1 0-4Z"/><path d="M5 7V5a2 2 0 0 1 2-2h10"/>
  {% elseif name == 'trophy' %}<path d="M8 4h8v5a4 4 0 0 1-8 0Z"/><path d="M8 6H4v2a4 4 0 0 0 4 4M16 6h4v2a4 4 0 0 1-4 4M12 13v4M8 21h8M9 17h6"/>
  {% elseif name == 'qr' %}<path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z"/><path d="M14 14h2v2h-2zM18 14h2v2h-2zM14 18h2v2h-2zM17 17h3v3h-3z"/>
  {% else %}<path d="M4 20V10M10 20V4M16 20v-7M22 20V7"/>{% endif %}
</svg>
{% endmacro %}
{% import _self as ui %}

<section class="merdpos-app merdpos-dashboard-v2" aria-labelledby="merdpos-dashboard-title">
  <header class="merdpos-dashboard-hero">
    <div class="merdpos-dashboard-hero-copy">
      <p class="merdpos-eyebrow">MERDPOS / HOME</p>
      <h1 id="merdpos-dashboard-title">{{ surface.title }}</h1>
      <p>{{ surface.description }}</p>
      <div class="merdpos-dashboard-roleline">
        <span>{{ surface.role.label|default('MERDPOS') }}</span>
        <span>LOA {{ surface.role.loa|default(0) }}</span>
        <span>{{ surface.visible_widget_count|default(0) }} authorized widgets</span>
      </div>
    </div>
    <div class="merdpos-dashboard-live merdpos-dashboard-live--{{ surface.status }}">
      <span class="merdpos-dashboard-live-pulse"></span>
      <div><strong>{{ surface.status_label }}</strong><small>Signed MERDPOS service</small></div>
    </div>
  </header>

  {% if surface.filters %}
    <form class="merdpos-dashboard-filters" method="get" aria-label="Dashboard filters">
      <div class="merdpos-dashboard-filter-title"><strong>Operational lens</strong><span>{{ surface.period_label }}</span></div>
      {% for filter in surface.filters %}
        <label><span>{{ filter.label }}</span><select name="{{ filter.name }}">
          {% for option in filter.options %}<option value="{{ option.value }}"{{ option.value == filter.value ? ' selected' : '' }}>{{ option.label }}</option>{% endfor %}
        </select></label>
      {% endfor %}
      <button type="submit">Apply view</button>
    </form>
  {% endif %}

  {% if surface.metrics %}
    <div class="merdpos-dashboard-kpis" aria-label="Role dashboard summary">
      {% for metric in surface.metrics %}
        <article class="merdpos-dashboard-kpi is-{{ metric.tone }}">
          <span class="merdpos-dashboard-kpi-icon">{{ ui.icon(metric.icon) }}</span>
          <div class="merdpos-dashboard-kpi-copy">
            <span>{{ metric.label }}</span><strong>{{ metric.value }}</strong><small>{{ metric.meta }}</small>
          </div>
          {% if metric.kind == 'change' %}
            <div class="merdpos-dashboard-delta is-{{ metric.direction }}"><b>{{ metric.change }}</b><span>{{ metric.detail }}</span></div>
          {% else %}
            <span class="merdpos-dashboard-kpi-spark" aria-hidden="true"></span>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}
  {% if surface.can_scan_attendance and surface.attendance_scan %}
    <article class="merdpos-attendance-widget" data-attendance-scan data-endpoint="{{ surface.attendance_scan.endpoint }}" data-csrf="{{ surface.attendance_scan.csrf }}">
      <div class="merdpos-attendance-widget-main">
        <span class="merdpos-attendance-widget-icon">{{ ui.icon('qr') }}</span>
        <div class="merdpos-attendance-widget-copy">
          <p class="merdpos-eyebrow">ATTENDANCE</p>
          <h2>Scan the POS QR</h2>
          <p>Use the current QR at your store to clock in or clock out. MERDPOS validates your account, store assignment and the live QR before changing attendance.</p>
        </div>
        <button type="button" class="merdpos-attendance-open" data-attendance-open>Scan attendance QR</button>
      </div>
      <div class="merdpos-attendance-panel" data-attendance-panel hidden>
        <div class="merdpos-attendance-camera">
          <video data-attendance-video playsinline muted aria-label="Attendance QR camera preview"></video>
          <div class="merdpos-attendance-target" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        </div>
        <div class="merdpos-attendance-controls">
          <div class="merdpos-attendance-status" data-attendance-status role="status" aria-live="polite">Camera is ready when you are.</div>
          <button type="button" class="merdpos-attendance-stop" data-attendance-stop>Close camera</button>
        </div>
        <form class="merdpos-attendance-manual" data-attendance-manual>
          <label><span>QR link or token fallback</span><input type="text" data-attendance-input maxlength="1800" autocomplete="off" spellcheck="false" placeholder="Paste the scanned MERDPOS QR link"></label>
          <button type="submit">Submit QR</button>
        </form>
        <div class="merdpos-attendance-result" data-attendance-result hidden>
          <strong data-attendance-result-action></strong>
          <span data-attendance-result-store></span>
          <small data-attendance-result-time></small>
          <button type="button" data-attendance-refresh>Refresh Home</button>
        </div>
      </div>
    </article>
  {% endif %}
  <div class="merdpos-dashboard-grid">
    {% for widget in surface.dashboard_widgets %}
      <article class="merdpos-dashboard-panel merdpos-dashboard-panel--{{ widget.kind }} merdpos-dashboard-panel--{{ widget.key }}">
        <header class="merdpos-dashboard-panel-head">
          <span class="merdpos-dashboard-panel-icon">{{ ui.icon(widget.icon) }}</span>
          <div><h2>{{ widget.title }}</h2><p>{{ widget.description }}</p></div>
          <span class="merdpos-dashboard-panel-live">LIVE</span>
        </header>

        <div class="merdpos-dashboard-panel-body">
          {% if widget.kind == 'chart' %}
            <div class="merdpos-dashboard-chart" role="img" aria-label="{{ widget.title }} chart">
              {{ attribute(charts, widget.chart_key) }}
            </div>
          {% elseif widget.kind == 'list' %}
            {% if widget.items %}<div class="merdpos-dashboard-people">
              {% for item in widget.items %}<div class="merdpos-dashboard-person">
                <span class="merdpos-dashboard-person-avatar">{{ item.title|first|upper }}</span>
                <div><strong>{{ item.title }}</strong><span>{{ item.meta }}</span></div>
                <time>{{ item.value }}</time>
              </div>{% endfor %}
            </div>{% else %}<p class="merdpos-dashboard-empty">{{ widget.empty }}</p>{% endif %}
          {% elseif widget.kind == 'ranking' %}
            {% if widget.items %}<ol class="merdpos-dashboard-ranking">
              {% for item in widget.items %}<li><span class="rank">{{ item.rank }}</span><strong>{{ item.title }}</strong><b>{{ item.value }}</b></li>{% endfor %}
            </ol>{% else %}<p class="merdpos-dashboard-empty">No ranked sales data yet.</p>{% endif %}
          {% elseif widget.kind == 'status' %}
            <div class="merdpos-dashboard-statuses">
              {% for item in widget.items %}<div class="is-{{ item.tone }}"><span></span><strong>{{ item.status }}</strong><b>{{ item.count }}</b></div>{% endfor %}
            </div>
          {% elseif widget.kind == 'table' %}
            {% if widget.rows %}<div class="merdpos-dashboard-table-wrap" tabindex="0" role="region" aria-label="{{ widget.title }} table"><table>
              <thead><tr>{% for column in widget.columns %}<th>{{ column.label }}</th>{% endfor %}</tr></thead>
              <tbody>{% for row in widget.rows %}<tr>{% for column in widget.columns %}<td>{{ attribute(row, column.key)|default('—') }}</td>{% endfor %}</tr>{% endfor %}</tbody>
            </table></div>{% else %}<p class="merdpos-dashboard-empty">{{ widget.empty }}</p>{% endif %}
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
  <footer class="merdpos-dashboard-footer">
    <div><strong>MERDPOS policy is authoritative</strong><span>Only dashboard widgets allowed for {{ surface.role.label|default('this role') }} are rendered.</span></div>
    <div class="merdpos-dashboard-footer-tags"><span>{{ surface.meta.source }}</span><span>No direct operational DB access</span></div>
  </footer>
</section>