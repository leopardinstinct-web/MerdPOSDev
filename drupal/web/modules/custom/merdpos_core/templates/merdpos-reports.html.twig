{% macro icon(name) %}
<svg viewBox="0 0 24 24" aria-hidden="true">
  {% if name == 'chart' %}<path d="M4 20V10M10 20V4M16 20v-7M22 20V7"/>
  {% elseif name == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
  {% elseif name == 'users' %}<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
  {% elseif name == 'message' %}<path d="M21 15a4 4 0 0 1-4 4H8l-5 3v-7a8 8 0 1 1 18 0Z"/><path d="M8 11h8M8 15h5"/>
  {% elseif name == 'download' %}<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>
  {% elseif name == 'print' %}<path d="M7 8V3h10v5"/><rect x="5" y="14" width="14" height="7"/><path d="M5 17H3v-7h18v7h-2"/>
  {% elseif name == 'wallet' %}<path d="M3 7h15a3 3 0 0 1 3 3v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M16 12h5v4h-5a2 2 0 0 1 0-4Z"/>
  {% elseif name == 'calendar' %}<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/>
  {% elseif name == 'more' %}<circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/>
  {% elseif name == 'plus' %}<path d="M12 5v14M5 12h14"/>
  {% elseif name == 'x' %}<path d="m6 6 12 12M18 6 6 18"/>
  {% else %}<path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6Z"/><path d="m9 12 2 2 4-5"/>{% endif %}
</svg>
{% endmacro %}
{% import _self as ui %}

<section class="merdpos-app merdpos-reports-v2" aria-labelledby="merdpos-reports-title">
  <header class="merdpos-page-header merdpos-reports-hero">
    <div class="merdpos-page-header__copy merdpos-reports-copy">
      <p class="merdpos-page-header__eyebrow merdpos-eyebrow">Timesheets</p>
      <h1 class="merdpos-page-header__title" id="merdpos-reports-title">{{ surface.title }}</h1>
      <p class="merdpos-page-header__description">{{ surface.description }}</p>
    </div>
    <div class="merdpos-page-header__actions merdpos-reports-header-actions">
      <button class="merdpos-report-action merdpos-reports-print-action" type="button" data-merdpos-print><span class="merdpos-report-download-icon" aria-hidden="true"></span><span>PDF</span></button>
      <form class="merdpos-reports-week-form" method="get" aria-label="Timesheet week">
        <label><span>Week</span><select name="week_start" data-timesheet-week-select>
          {% for option in surface.week_options %}<option value="{{ option.value }}"{{ option.value == surface.selected_week ? ' selected' : '' }}>{{ option.label }}</option>{% endfor %}
        </select></label>
        <noscript><button type="submit">Apply week</button></noscript>
      </form>
    </div>
  </header>

  <div class="merdpos-reports-kpis" aria-label="Timesheets summary">
    {% for metric in surface.metrics %}
      {% set metric_icon = metric.label|lower == 'queries' ? 'message' : 'clock' %}
      <article class="merdpos-reports-kpi is-{{ metric.tone }}">
        <span class="merdpos-reports-kpi-icon">{{ ui.icon(metric_icon) }}</span>
        <div><span>{{ metric.label }}</span>
          <div class="merdpos-reports-kpi-lines">
            {% for line in metric.lines %}<strong><b>{{ line.value }}</b><small>{{ line.label }}</small></strong>{% endfor %}
          </div>
        </div>
      </article>
    {% endfor %}
  </div>

  <div class="merdpos-reports-note"><span>{{ ui.icon('shield') }}</span><div><strong>Frozen reconciliation preserved</strong><p>Hours, lateness, wages and queries come from the existing MERDPOS timesheet engine. Drupal renders only the already-authorized result for the selected week.</p></div></div>
  <div class="merdpos-reports-groups">
    {% for group in surface.groups %}
      <article class="merdpos-report-table-card"{% if group.title == 'Filtered shifts' %} id="merdpos-shift-detail"{% endif %}>
        <header><div><p class="merdpos-eyebrow">{{ group.eyebrow }}</p><h2>{{ group.title }}</h2></div><span class="merdpos-report-count">{{ group.rows|length }}</span></header>
        {% if group.rows %}
          <div class="merdpos-report-table-wrap" tabindex="0" role="region" aria-label="{{ group.title }} table"><table><thead><tr>{% for column in group.columns %}<th scope="col">{{ column.label }}</th>{% endfor %}</tr></thead><tbody>
          {% for row in group.rows %}<tr>{% for column in group.columns %}<td>{% if column.key == 'action' %}
            {% set action = attribute(row, 'action')|default({}) %}{% set dispute = action.dispute|default(null) %}
            {% if dispute or action.can_dispute or action.can_add_missing %}
            <button type="button" class="merdpos-timesheet-action-trigger{{ dispute ? ' has-dispute is-' ~ dispute.status : '' }}" data-timesheet-action data-shift-id="{{ action.shift_id }}" data-store-id="{{ action.store_id }}" data-employee="{{ action.employee }}" data-date="{{ action.date }}" data-in="{{ action.in }}" data-out="{{ action.out }}" data-can-dispute="{{ action.can_dispute ? '1' : '0' }}" data-can-add-missing="{{ action.can_add_missing ? '1' : '0' }}" data-dispute-id="{{ dispute.id|default('') }}" data-dispute-status="{{ dispute.status|default('') }}" data-dispute-status-label="{{ dispute.status_label|default('') }}" data-dispute-type-label="{{ dispute.type_label|default('') }}" data-dispute-reason="{{ dispute.reason|default('') }}" data-dispute-submitted="{{ dispute.submitted|default('') }}" data-dispute-decision-note="{{ dispute.decision_note|default('') }}" data-dispute-requested-in="{{ dispute.requested_in|default('') }}" data-dispute-requested-out="{{ dispute.requested_out|default('') }}" data-can-cancel="{{ dispute.can_cancel|default(false) ? '1' : '0' }}" data-can-review="{{ dispute.can_review|default(false) ? '1' : '0' }}" data-can-handover="{{ dispute.can_handover|default(false) ? '1' : '0' }}" aria-label="{{ dispute ? 'Open ' ~ dispute.status_label ~ ' dispute for ' ~ action.employee ~ ' on ' ~ action.date : 'Shift options for ' ~ action.employee ~ ' on ' ~ action.date }}" aria-haspopup="{{ dispute ? 'dialog' : 'menu' }}" aria-expanded="false" title="{{ dispute ? dispute.status_label ~ ' dispute' : 'Shift options' }}"><span class="merdpos-timesheet-action-icon" aria-hidden="true"></span>{% if dispute %}<span class="merdpos-timesheet-dispute-dot" aria-hidden="true"></span>{% endif %}</button>
            {% else %}—{% endif %}
          {% else %}{{ attribute(row, column.key)|default('—') }}{% endif %}</td>{% endfor %}</tr>{% endfor %}
          </tbody></table></div>
        {% else %}<p class="merdpos-report-empty">{{ group.empty }}</p>{% endif %}
      </article>
    {% endfor %}
  </div>

  <div class="merdpos-timesheet-action-menu" data-timesheet-menu role="menu" aria-label="Shift options" hidden>
    <button type="button" role="menuitem" data-timesheet-menu-choice="missing">{{ ui.icon('plus') }}<span>Missing shift</span></button>
    <button type="button" role="menuitem" data-timesheet-menu-choice="dispute">{{ ui.icon('message') }}<span>Dispute existing shift</span></button>
  </div>

  <dialog class="merdpos-timesheet-dialog" data-timesheet-dialog aria-labelledby="merdpos-timesheet-dialog-title">
    <div class="merdpos-timesheet-dialog-shell">
      <header><div><p class="merdpos-eyebrow">SHIFT DETAIL</p><h2 id="merdpos-timesheet-dialog-title" data-timesheet-dialog-title>Shift details</h2><p data-timesheet-dialog-context></p></div><button type="button" class="merdpos-timesheet-dialog-close" data-timesheet-dialog-close aria-label="Close">{{ ui.icon('x') }}</button></header>
      <section class="merdpos-timesheet-existing" data-timesheet-existing hidden>
        <div class="merdpos-timesheet-status"><span data-dispute-status></span><strong data-dispute-type></strong><p data-dispute-requested hidden></p><p data-dispute-reason></p><small data-dispute-meta></small><p data-dispute-note hidden></p></div>
        <div class="merdpos-timesheet-existing-actions">
          <form method="post" action="{{ dispute_post_url }}" data-dispute-cancel hidden><input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="return_query" value=""><input type="hidden" name="dispute_action" value="cancel"><input type="hidden" name="dispute_id" value=""><button type="submit" class="is-danger">Cancel dispute</button></form>
          <form method="post" action="{{ dispute_post_url }}" data-dispute-handover hidden><input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="return_query" value=""><input type="hidden" name="dispute_id" value=""><button type="submit" name="dispute_action" value="confirm_handover">Confirm & send for review</button><button type="submit" name="dispute_action" value="reject_handover" class="is-secondary">This is incorrect</button></form>
          <form method="post" action="{{ dispute_post_url }}" data-dispute-review hidden><input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="return_query" value=""><input type="hidden" name="dispute_action" value="decide"><input type="hidden" name="dispute_id" value=""><label>Decision note<textarea name="note" rows="3" maxlength="1000"></textarea></label><div><button type="submit" name="decision" value="approved">Approve</button><button type="submit" name="decision" value="rejected" class="is-danger">Reject</button></div></form>
        </div>
      </section>
      <section class="merdpos-timesheet-create" data-timesheet-create hidden>
        <p class="merdpos-timesheet-create-help" data-timesheet-create-help></p>
        <form method="post" action="{{ dispute_post_url }}" data-timesheet-create-form>
          <input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="return_query" value=""><input type="hidden" name="dispute_action" value="create"><input type="hidden" name="shift_id" value=""><input type="hidden" name="dispute_type" value="other" data-dispute-type-hidden>
          <div data-timesheet-dispute-fields><label>Issue<select data-dispute-type-select><option value="other">Other correction</option><option value="missing_out">Missing clock-out</option><option value="wrong_in">Wrong clock-in</option><option value="wrong_out">Wrong clock-out</option><option value="delete_shift">Delete this shift</option></select></label></div>
          <label data-proposed-store-field hidden>Store<select name="proposed_store_id"><option value="">Choose store</option>{% for store in surface.action_stores %}<option value="{{ store.id }}">{{ store.name }}</option>{% endfor %}</select></label>
          <label data-requested-in-field hidden>Requested clock-in<input type="datetime-local" name="requested_clock_in"></label>
          <label data-requested-out-field hidden>Requested clock-out<input type="datetime-local" name="requested_clock_out"></label>
          <label>Reason<textarea name="reason" rows="4" minlength="5" maxlength="1000" required></textarea></label>
          <div class="merdpos-timesheet-form-actions"><button type="submit" data-timesheet-submit>Submit dispute</button></div>
        </form>
      </section>
    </div>
  </dialog>
  <footer class="merdpos-reports-footer"><div><strong>Authoritative source</strong><span>{{ surface.meta.source }}</span></div><div><span>{{ surface.meta.scope }}</span><span>No direct operational DB access</span></div></footer>
</section>
