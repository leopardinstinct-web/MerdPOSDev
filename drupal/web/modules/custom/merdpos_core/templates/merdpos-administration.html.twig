{% set permissions = directory.permissions|default({}) %}
{% set actor = directory.actor|default({}) %}
{% set stores = directory.stores|default([]) %}
{% set employees = directory.employees|default([]) %}
{% set store_fields = directory.store_edit_fields|default([]) %}
{% set roles = actor.roles|default([]) %}
{% set authority_roles = role_state.roles|default([]) %}
{% set permission_rules = role_state.permissions|default([]) %}
{% set can_manage_permissions = role_state.can_manage_permissions|default(false) %}
{% set actor_authority = role_state.actor_authority_level|default(0) %}
{% set post_url = path('merdpos_core.administration', {}, {'query': {'client_id': selected_client_id, 'tab': current_tab}}) %}

<section class="merdpos-admin-v1" data-merdpos-admin data-legacy-url="{{ legacy_url }}" data-legacy-token="{{ legacy_token }}" data-can-manage-legacy="{{ can_manage_legacy ? '1' : '0' }}">
  <header class="merdpos-admin-hero">
    <div>
      <p class="merdpos-admin-eyebrow">ADMINISTRATION WRITE PARITY</p>
      <h1>Clients, stores and workforce.</h1>
      <p>One governed workspace. Every save is re-authorised by MERDPOS and written through the signed service boundary.</p>
      <div class="merdpos-admin-badges">
        <span>{{ actor.role_label|default('Management') }}</span>
        <span>LOA {{ actor.authority_level|default(0) }}</span>
        <span>Authoritative writes</span>
      </div>
    </div>
    {% if current_tab in ['stores', 'defaults', 'workforce', 'roles'] %}
      {% if can_select_client %}
      <form class="merdpos-admin-client-switch merdpos-admin-client-switch--hero" method="get">
        <input type="hidden" name="tab" value="{{ current_tab }}">
        <label><span>Working client</span>
          <select name="client_id" onchange="this.form.submit()">
            {% for client in selectable_clients %}
              <option value="{{ client.id }}"{{ client.id == selected_client_id ? ' selected' : '' }}>{{ client.name }} &middot; {{ client.client_code }}</option>
            {% endfor %}
          </select>
        </label>
        <noscript><button type="submit">Switch</button></noscript>
      </form>
      {% else %}
      <div class="merdpos-admin-context-card">
        <small>Working client</small>
        <strong>{{ selected_client.name|default('MERDPOS client') }}</strong>
        <span>{{ selected_client.client_code|default('') }}</span>
      </div>
      {% endif %}
    {% endif %}
  </header>


  {% if can_manage_clients %}
  <section class="merdpos-admin-section is-active merdpos-onboard-v2" data-admin-panel="onboarding">
    <div class="merdpos-admin-section-head">
      <div><p>GUIDED PROVISIONING</p><h2>Client &rarr; store &rarr; admin</h2><span>Provision the minimum working MERDPOS tenant from one governed submission.</span></div>
      <span class="merdpos-admin-permission">DEV &middot; clients.manage</span>
    </div>
    <div class="merdpos-onboard-steps" aria-label="Onboarding steps"><span><b>1</b> Client</span><i></i><span><b>2</b> First store</span><i></i><span><b>3</b> Initial admin</span></div>
    <form method="post" action="{{ post_url }}" class="merdpos-onboard-form" data-onboard-form>
      <input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="entity_action" value="onboard_client">
      <fieldset><legend><b>1</b><span>Client identity</span></legend><div class="merdpos-onboard-grid">
        <label><span>Client name</span><input name="onboard_client_name" maxlength="100" required placeholder="Example Retail Group"></label>
        <label><span>Client code</span><input name="onboard_client_code" maxlength="50" pattern="[A-Za-z0-9][A-Za-z0-9_-]+" required placeholder="EXAMPLE"></label>
      </div></fieldset>
      <fieldset><legend><b>2</b><span>First store</span></legend><div class="merdpos-onboard-grid">
        <label><span>Store name</span><input name="onboard_store_name" maxlength="150" required placeholder="Example Central"></label>
        <label><span>Store code</span><input name="onboard_store_code" maxlength="50" placeholder="Optional &mdash; generated if blank"></label>
        <label class="is-wide"><span>Address</span><input name="onboard_store_address" maxlength="1000" placeholder="Optional"></label>
        <label><span>Store email</span><input type="email" name="onboard_store_email" maxlength="255" placeholder="Optional"></label>
        <label><span>Store phone</span><input type="tel" name="onboard_store_phone" maxlength="50" placeholder="Optional"></label>
        <label><span>Week starts</span><select name="onboard_week_start_day"><option value="1">Monday</option><option value="7">Sunday</option></select></label>
        <label><span>Timezone</span><input name="onboard_store_timezone" value="Australia/Sydney"></label>
        <label><span>Currency</span><input name="onboard_store_currency" maxlength="3" value="AUD"></label>
      </div>
      <label class="merdpos-onboard-schedule-toggle"><input type="checkbox" name="onboard_schedule_enabled" value="1" data-onboard-schedule-toggle><span>Configure weekly trading hours now</span></label>
      <div class="merdpos-onboard-schedule" data-onboard-schedule hidden>
        {% set day_names = {1:'Monday',2:'Tuesday',3:'Wednesday',4:'Thursday',5:'Friday',6:'Saturday',7:'Sunday'} %}
        {% for day, label in day_names %}
          <div class="merdpos-onboard-day"><strong>{{ label }}</strong><label><span>Open</span><input type="time" name="onboard_day_{{ day }}_start" value="09:00"></label><label><span>Close</span><input type="time" name="onboard_day_{{ day }}_end" value="17:00"></label><label class="merdpos-onboard-closed"><input type="checkbox" name="onboard_day_{{ day }}_closed" value="1" data-onboard-day-closed><span>Closed</span></label></div>
        {% endfor %}
      </div></fieldset>
      <fieldset><legend><b>3</b><span>Initial administrator</span></legend><div class="merdpos-onboard-grid">
        <label><span>Full name</span><input name="onboard_admin_name" maxlength="190" required></label>
        <label><span>User ID</span><input name="onboard_admin_user_id" inputmode="numeric" maxlength="32" pattern="[0-9]+" required></label>
        <label><span>Numeric password</span><input type="password" name="onboard_admin_password" inputmode="numeric" minlength="4" maxlength="20" pattern="[0-9]+" required autocomplete="new-password"></label>
        <label><span>Hourly rate</span><input name="onboard_admin_rate" inputmode="decimal" value="0.00"></label>
      </div></fieldset>
      <div class="merdpos-onboard-review"><strong>One submission, three authoritative writes.</strong><span>If a later step is rejected, MERDPOS keeps the completed records and tells you exactly where to resume instead of silently rolling back valid audited work.</span></div>
      <div class="merdpos-admin-form-actions"><button type="submit" data-onboard-submit>Provision client</button></div>
    </form>
  </section>
  {% endif %}

  {% if can_manage_clients %}
  <section class="merdpos-admin-section" data-admin-panel="clients">
    <div class="merdpos-admin-section-head">
      <div><p>PLATFORM</p><h2>Clients</h2><span>Create tenants and maintain their lifecycle.</span></div>
      <div class="merdpos-admin-head-actions"><label class="merdpos-admin-search"><span>Search clients</span><input type="search" data-admin-search="clients" placeholder="Name or code"></label><span class="merdpos-admin-permission">DEV &middot; clients.manage</span></div>
    </div>
    <details class="merdpos-admin-editor merdpos-admin-editor--new">
      <summary><strong>New client</strong><span>Add a governed MERDPOS tenant</span></summary>
      <form method="post" action="{{ post_url }}" class="merdpos-admin-form">
        <input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="entity_action" value="save_client">
        <label><span>Client name</span><input name="name" maxlength="100" required></label>
        <label><span>Client code</span><input name="client_code" maxlength="50" pattern="[A-Za-z0-9][A-Za-z0-9_-]+" required></label>
        <label><span>Status</span><select name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select></label>
        <div class="merdpos-admin-form-actions"><button type="submit">Create client</button></div>
      </form>
    </details>
    <div class="merdpos-admin-list">
      {% for client in clients %}
      <details class="merdpos-admin-editor" data-search-text="{{ client.name }} {{ client.client_code }} {{ client.status }}">
        <summary><div><strong>{{ client.name }}</strong><span>{{ client.client_code }}</span></div><div class="merdpos-admin-summary-meta"><b>{{ client.status }}</b><span>{{ client.store_count }} stores &middot; {{ client.employee_count }} people</span>{% if client.attendance_authority is defined %}<span>Attendance: {{ client.attendance_authority|replace({'_':' '}) }}</span>{% endif %}{% if client.financial_authority is defined %}<span>Finance: {{ client.financial_authority|replace({'_':' '}) }}</span>{% endif %}{% if can_manage_legacy %}<button type="button" class="merdpos-legacy-open" data-legacy-open="{{ client.id }}" data-legacy-client-code="{{ client.client_code }}" aria-label="Legacy Sync {{ client.name }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7h-6V1"/><path d="M20 1a9 9 0 0 0-15 4"/><path d="M4 17h6v6"/><path d="M4 23a9 9 0 0 0 15-4"/></svg><span>Legacy Sync</span></button>{% endif %}</div></summary>
        <form method="post" action="{{ post_url }}" class="merdpos-admin-form">
          <input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="entity_action" value="save_client"><input type="hidden" name="id" value="{{ client.id }}">
          <label><span>Client name</span><input name="name" maxlength="100" value="{{ client.name }}" required></label>
          <label><span>Client code</span><input name="client_code" maxlength="50" value="{{ client.client_code }}" required></label>
          <label><span>Status</span><select name="status"><option value="active"{{ client.status == 'active' ? ' selected' : '' }}>Active</option><option value="inactive"{{ client.status == 'inactive' ? ' selected' : '' }}>Inactive</option></select></label>
          <div class="merdpos-admin-form-actions"><button type="submit">Save client</button></div>
        </form>
      </details>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="merdpos-admin-section{{ can_manage_clients ? '' : ' is-active' }}" data-admin-panel="stores">
    <div class="merdpos-admin-section-head">
      <div><p>OPERATIONS</p><h2>Stores</h2><span>Create locations and maintain operational identity.</span></div>
      <div class="merdpos-admin-head-actions"><label class="merdpos-admin-search"><span>Search stores</span><input type="search" data-admin-search="stores" placeholder="Search name, code, ID, address or status"></label><span class="merdpos-admin-permission">stores.manage</span></div>
    </div>
    {% if permissions['stores.manage']|default(false) %}
    <details class="merdpos-admin-editor merdpos-admin-editor--new">
      <summary><strong>New store</strong><span>Create inside {{ selected_client.name|default('current client') }}</span></summary>
      <form method="post" action="{{ post_url }}" enctype="multipart/form-data" class="merdpos-admin-form merdpos-admin-form--wide" data-store-new-form>
        <input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="entity_action" value="save_store">
        <label><span>Store name</span><input name="store_name" maxlength="150" required data-store-name></label>
        <label><span>Status</span><select name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select></label>
        <label><span>Week starts</span><select name="week_start_day">{% for d,label in {1:'Monday',2:'Tuesday',3:'Wednesday',4:'Thursday',5:'Friday',6:'Saturday',7:'Sunday'} %}<option value="{{ d }}"{{ d == 1 ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
        {% if permissions['stores.profile.manage']|default(false) %}
        {% if store_identity_available %}<input type="hidden" name="store_identity_enabled" value="1"><label class="merdpos-store-id-field"><span>Internal Store ID <em>DEV</em></span><input type="text" value="Assigned automatically" readonly tabindex="-1"><small>Database primary key; intentionally read-only.</small></label>{% endif %}
        {% for field in store_fields %}
          {% if field.name in ['store_code','code'] %}<label class="merdpos-store-code-field"><span>Store Code {% if store_identity_available %}<em>DEV</em>{% endif %}</span><input name="{{ field.name }}" minlength="2" maxlength="50" pattern="[A-Za-z0-9][A-Za-z0-9_-]{1,49}" autocomplete="off" spellcheck="false" required data-store-code><small>Unique inside the client. A–Z, 0–9, hyphen and underscore.</small></label>
          {% elseif field.name in ['address','address_line1'] %}<label class="is-wide"><span>Shop address</span><textarea name="{{ field.name }}" maxlength="{{ field.max_length|default(1000) }}" rows="3" placeholder="Street address, suburb, state, postcode"></textarea></label>
          {% elseif field.name == 'timezone' %}<label><span>{{ field.label }}</span><select name="timezone"><option value="">Client default</option>{% for tz in timezone_options %}<option value="{{ tz }}">{{ tz }}</option>{% endfor %}</select></label>
          {% elseif field.name == 'currency_code' %}<label><span>{{ field.label }}</span><select name="currency_code"><option value="">Client default</option>{% for code in currency_options %}<option value="{{ code }}">{{ code }}</option>{% endfor %}</select></label>
          {% else %}<label class="{{ field.wide ? 'is-wide' : '' }}"><span>{{ field.label }}</span><input type="{{ field.type|default('text') }}" name="{{ field.name }}" maxlength="{{ field.max_length|default(255) }}"></label>{% endif %}
        {% endfor %}
        {% if store_identity_available %}<label class="is-wide"><span>Google Maps URL</span><input name="google_maps_url" type="url" maxlength="2048" placeholder="https://maps.app.goo.gl/..."><small>HTTPS Google Maps links only.</small></label>{% endif %}
        {% endif %}
        {% if permissions['stores.timings.manage']|default(false) %}
        <fieldset class="merdpos-store-hours is-wide"><legend>Store hours</legend><p>Opening and closing times for each day.</p>
          {% set day_names = {1:'Monday',2:'Tuesday',3:'Wednesday',4:'Thursday',5:'Friday',6:'Saturday',7:'Sunday'} %}
          <div class="merdpos-store-hours-grid">{% for d,label in day_names %}<div class="merdpos-store-hour-row"><strong>{{ label }}</strong><label><span>Open</span><input type="time" name="days[{{ d }}][start_time]" value="09:00"></label><label><span>Close</span><input type="time" name="days[{{ d }}][end_time]" value="17:00"></label><label class="merdpos-store-closed"><input type="hidden" name="days[{{ d }}][is_closed]" value="0"><input type="checkbox" name="days[{{ d }}][is_closed]" value="1"><span>Closed</span></label></div>{% endfor %}</div>
        </fieldset>{% endif %}
        {% if permissions['stores.logo.manage']|default(false) %}{% if store_identity_available %}<label class="is-wide merdpos-store-logo-field merdpos-store-logo-field--identity"><span>Store logo</span><input type="file" name="logo" accept="image/png,image/jpeg,image/webp"><small>PNG, JPEG or WebP · max 2 MB · 32–4096 px. Square or rectangular shop logos are supported.</small></label>{% else %}<div class="merdpos-store-logo-note is-wide"><strong>Store logo</strong><span>Create the store first, then upload its PNG, JPEG or WebP logo from the store editor.</span></div>{% endif %}{% endif %}
        <div class="merdpos-admin-form-actions"><button type="submit">Create store</button></div>
      </form>
    </details>
    {% endif %}
    <div class="merdpos-admin-list">
      {% for store in stores %}
      <details class="merdpos-admin-editor" data-search-text="{{ store.store_name }} {{ store.store_code|default(store.code|default('')) }} {{ store.id }} ID {{ store.id }} {{ store.status }} {{ store.address|default('') }} {{ store.google_maps_url|default('') }} {{ store.timezone|default('') }} {{ store.currency_code|default('') }}">
        {% set week_names = {1:'Monday',2:'Tuesday',3:'Wednesday',4:'Thursday',5:'Friday',6:'Saturday',7:'Sunday'} %}<summary class="merdpos-store-summary"><div class="merdpos-store-summary-main">{% if store.logo_path|default('') %}<span class="merdpos-store-summary-logo"><img src="{{ store.logo_path }}" alt="{{ store.store_name }} logo"></span>{% endif %}<div><strong>{{ store.store_name }}</strong><span>{{ store.store_code|default(store.code|default('')) }} · ID {{ store.id }}</span>{% if store.address|default('') %}<small>{{ store.address }}</small>{% endif %}{% if store.google_maps_url|default('') %}<a href="{{ store.google_maps_url }}" target="_blank" rel="noopener noreferrer" class="merdpos-store-map-link" data-store-map-link>Open in Google Maps ↗</a>{% endif %}</div></div><div class="merdpos-admin-summary-meta"><b>{{ store.status }}</b><span>Week starts {{ week_names[store.week_start_day]|default('Monday') }}</span></div></summary>
        {% if permissions['stores.manage']|default(false) %}
        <form method="post" action="{{ post_url }}" enctype="multipart/form-data" class="merdpos-admin-form merdpos-admin-form--wide">
          <input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="entity_action" value="save_store"><input type="hidden" name="id" value="{{ store.id }}">
          <label><span>Store name</span><input name="store_name" maxlength="150" value="{{ store.store_name }}" required></label>
          <label><span>Status</span><select name="status"><option value="active"{{ store.status == 'active' ? ' selected' : '' }}>Active</option><option value="inactive"{{ store.status == 'inactive' ? ' selected' : '' }}>Inactive</option></select></label>
          <label><span>Week starts</span><select name="week_start_day">{% for d,label in {1:'Monday',2:'Tuesday',3:'Wednesday',4:'Thursday',5:'Friday',6:'Saturday',7:'Sunday'} %}<option value="{{ d }}"{{ d == store.week_start_day ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
          {% if permissions['stores.profile.manage']|default(false) %}
          {% if store_identity_available %}<input type="hidden" name="store_identity_enabled" value="1"><label class="merdpos-store-id-field"><span>Internal Store ID <em>DEV</em></span><input type="text" value="{{ store.id }}" readonly tabindex="-1"><small>Database primary key; intentionally read-only.</small></label>{% endif %}
          {% for field in store_fields %}
            {% if field.name in ['store_code','code'] %}<label class="merdpos-store-code-field"><span>Store Code {% if store_identity_available %}<em>DEV</em>{% endif %}</span><input name="{{ field.name }}" minlength="2" maxlength="50" pattern="[A-Za-z0-9][A-Za-z0-9_-]{1,49}" autocomplete="off" spellcheck="false" required data-store-code value="{{ attribute(store, field.name)|default('') }}"><small>Unique inside the client. A–Z, 0–9, hyphen and underscore.</small></label>
            {% elseif field.name in ['address','address_line1'] %}<label class="is-wide"><span>Shop address</span><textarea name="{{ field.name }}" maxlength="{{ field.max_length|default(1000) }}" rows="3" placeholder="Street address, suburb, state, postcode">{{ attribute(store, field.name)|default('') }}</textarea></label>
            {% elseif field.name == 'timezone' %}<label><span>{{ field.label }}</span><select name="timezone"><option value="">Client default</option>{% for tz in timezone_options %}<option value="{{ tz }}"{{ tz == attribute(store, field.name)|default('') ? ' selected' : '' }}>{{ tz }}</option>{% endfor %}</select></label>
            {% elseif field.name == 'currency_code' %}<label><span>{{ field.label }}</span><select name="currency_code"><option value="">Client default</option>{% for code in currency_options %}<option value="{{ code }}"{{ code == attribute(store, field.name)|default('') ? ' selected' : '' }}>{{ code }}</option>{% endfor %}</select></label>
            {% else %}<label class="{{ field.wide ? 'is-wide' : '' }}"><span>{{ field.label }}</span><input type="{{ field.type|default('text') }}" name="{{ field.name }}" maxlength="{{ field.max_length|default(255) }}" value="{{ attribute(store, field.name)|default('') }}"></label>{% endif %}
          {% endfor %}
          {% if store_identity_available %}<label class="is-wide"><span>Google Maps URL</span><input name="google_maps_url" type="url" maxlength="2048" placeholder="https://maps.app.goo.gl/..." value="{{ store.google_maps_url|default('') }}"><small>HTTPS Google Maps links only.</small></label>{% endif %}
          {% endif %}
          {% if permissions['stores.timings.manage']|default(false) %}
          <fieldset class="merdpos-store-hours is-wide"><legend>Store hours</legend><p>Opening and closing times for each day.</p>
            {% set day_names = {1:'Monday',2:'Tuesday',3:'Wednesday',4:'Thursday',5:'Friday',6:'Saturday',7:'Sunday'} %}{% set store_schedule = store_timings[store.id]|default({}) %}
            <div class="merdpos-store-hours-grid">{% for d,label in day_names %}{% set timing = store_schedule[d]|default({}) %}<div class="merdpos-store-hour-row"><strong>{{ label }}</strong><label><span>Open</span><input type="time" name="days[{{ d }}][start_time]" value="{{ timing.start_time|default('09:00')|slice(0,5) }}"></label><label><span>Close</span><input type="time" name="days[{{ d }}][end_time]" value="{{ timing.end_time|default('17:00')|slice(0,5) }}"></label><label class="merdpos-store-closed"><input type="hidden" name="days[{{ d }}][is_closed]" value="0"><input type="checkbox" name="days[{{ d }}][is_closed]" value="1"{{ timing.is_closed|default(0) ? ' checked' : '' }}><span>Closed</span></label></div>{% endfor %}</div>
          </fieldset>{% endif %}
          {% if permissions['stores.logo.manage']|default(false) %}<label class="is-wide merdpos-store-logo-field merdpos-store-logo-field--identity">{% if store.logo_path|default('') %}<span class="merdpos-store-logo-preview"><img src="{{ store.logo_path }}" alt="{{ store.store_name }} logo"></span>{% endif %}<span>Store logo</span><input type="file" name="logo" accept="image/png,image/jpeg,image/webp"><small>PNG, JPEG or WebP · max 2 MB · 32–4096 px. Square or rectangular shop logos are supported.</small></label>{% endif %}
          <div class="merdpos-admin-form-actions"><button type="submit">Save store</button></div>
        </form>
        {% endif %}
      </details>
      {% else %}<div class="merdpos-admin-empty">No stores are available in this client context.</div>{% endfor %}
    </div>
  </section>

  {% if can_manage_defaults %}
  {% set defaults_client = defaults_state.client|default({}) %}
  {% set defaults_stores = defaults_state.stores|default([]) %}
  {% set defaults_currencies = defaults_state.currencies|default([]) %}
  {% set defaults_timezones = defaults_state.timezones|default([]) %}
  <section class="merdpos-admin-section merdpos-defaults" data-admin-panel="defaults">
    <div class="merdpos-admin-section-head">
      <div><p>OPERATIONS</p><h2>Defaults</h2><span>Set client defaults and optional per-store overrides for currency and timezone.</span></div>
      <span class="merdpos-admin-permission">DEV &middot; defaults.manage</span>
    </div>
    <div class="merdpos-defaults-section">
      <div class="merdpos-defaults-section-head"><div><h3>Client defaults</h3><p>Stores inherit these values unless you set an override below.</p></div></div>
      <form method="post" action="{{ post_url }}" class="merdpos-defaults-form">
        <input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="entity_action" value="save_client_defaults">
        <label><span>Currency</span><select name="default_currency" required>{% for code in defaults_currencies %}<option value="{{ code }}"{{ code == defaults_client.default_currency ? ' selected' : '' }}>{{ code }}</option>{% endfor %}</select></label>
        <label><span>Timezone</span><select name="default_timezone" required>{% for tz in defaults_timezones %}<option value="{{ tz }}"{{ tz == defaults_client.default_timezone ? ' selected' : '' }}>{{ tz }}</option>{% endfor %}</select></label>
        <button type="submit">Save client defaults</button>
      </form>
    </div>
    <div class="merdpos-defaults-section">
      <div class="merdpos-defaults-section-head"><div><h3>Store overrides</h3><p>Leave a field on “Use client default” to inherit automatically.</p></div></div>
      <div class="merdpos-defaults-store-list">
        {% for store in defaults_stores %}
        <article class="merdpos-defaults-store-row{{ store.status == 'inactive' ? ' is-muted' : '' }}" data-store-default-row="{{ store.id }}">
          <div class="merdpos-defaults-store-copy"><strong>{{ store.store_name }}</strong><small>Code {{ store.store_code }} &middot; ID {{ store.id }} &middot; {{ store.status }}</small><div class="merdpos-defaults-effective"><span>Effective {{ store.effective_currency }}</span><span>{{ store.effective_timezone }}</span></div></div>
          <form method="post" action="{{ post_url }}" class="merdpos-defaults-store-form">
            <input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="entity_action" value="save_store_defaults"><input type="hidden" name="store_id" value="{{ store.id }}">
            <label><span>Currency</span><select name="currency_code"><option value="">Use client default ({{ defaults_client.default_currency }})</option>{% for code in defaults_currencies %}<option value="{{ code }}"{{ code == store.currency_code ? ' selected' : '' }}>{{ code }}</option>{% endfor %}{% if store.currency_code and store.currency_code not in defaults_currencies %}<option value="{{ store.currency_code }}" selected>{{ store.currency_code }}</option>{% endif %}</select></label>
            <label><span>Timezone</span><select name="timezone"><option value="">Use client default ({{ defaults_client.default_timezone }})</option>{% for tz in defaults_timezones %}<option value="{{ tz }}"{{ tz == store.timezone ? ' selected' : '' }}>{{ tz }}</option>{% endfor %}</select></label>
            <button type="submit">Save</button>
          </form>
        </article>
        {% else %}<div class="merdpos-admin-empty">No stores exist for this client.</div>{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section class="merdpos-admin-section" data-admin-panel="workforce">
    <div class="merdpos-admin-section-head">
      <div><p>PEOPLE</p><h2>Workforce</h2><span>Create employees, assign role/LOA authority and control store access.</span></div>
      <div class="merdpos-admin-head-actions"><label class="merdpos-admin-search"><span>Search workforce</span><input type="search" data-admin-search="workforce" placeholder="Name, ID or role"></label><span class="merdpos-admin-permission">workforce.manage</span></div>
    </div>
    {% if permissions['workforce.manage']|default(false) %}
    <details class="merdpos-admin-editor merdpos-admin-editor--new">
      <summary><strong>New employee</strong><span>Add to {{ selected_client.name|default('current client') }}</span></summary>
      <form method="post" action="{{ post_url }}" class="merdpos-admin-form merdpos-admin-form--wide">
        <input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="entity_action" value="save_employee">
        <label><span>Full name</span><input name="full_name" maxlength="190" required></label>
        <label><span>User ID</span><input name="user_id" inputmode="numeric" maxlength="32" pattern="[0-9]+" required></label>
        <label><span>Role</span><select name="client_role_id" required>{% for role in roles %}<option value="{{ role.id }}">{{ role.role_label }} &middot; LOA {{ role.authority_level }}</option>{% endfor %}</select></label>
        <label><span>Status</span><select name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select></label>
        <label><span>Store access</span><select name="store_access_mode" data-store-mode><option value="all">All stores</option><option value="selected">Selected stores</option></select></label>
        <label class="is-wide"><span>Allowed stores</span><select name="store_ids[]" multiple size="{{ stores|length > 4 ? 4 : (stores|length > 0 ? stores|length : 1) }}" data-store-list>{% for store in stores %}{% if store.status == 'active' %}<option value="{{ store.id }}">{{ store.store_name }}</option>{% endif %}{% endfor %}</select></label>
        {% if permissions['workforce.payrates.manage']|default(false) %}<label><span>Hourly rate</span><input name="hourly_rate" inputmode="decimal" value="0.00" required></label><label><span>Rate effective</span><input type="date" name="rate_effective_date" value="{{ directory.today }}" required></label>{% endif %}
        <label><span>Numeric password</span><input type="password" name="new_password" inputmode="numeric" minlength="4" maxlength="20" pattern="[0-9]+" required autocomplete="new-password"></label>
        <div class="merdpos-admin-form-actions"><button type="submit">Create employee</button></div>
      </form>
    </details>
    {% endif %}
    <div class="merdpos-admin-list">
      {% for employee in employees %}
      <details class="merdpos-admin-editor" data-search-text="{{ employee.full_name }} {{ employee.user_id }} {{ employee.role_label }} {{ employee.employee_type|default('') }} {{ employee.status }}">
        <summary><div><strong>{{ employee.full_name }}</strong><span>ID {{ employee.user_id }} &middot; {{ employee.role_label }}</span></div><div class="merdpos-admin-summary-meta"><b>{{ employee.status }}</b><span>{{ employee.store_access_mode == 'selected' ? employee.assigned_store_ids|length ~ ' stores' : 'All stores' }}</span></div></summary>
        {% if employee.editable %}
        <form method="post" action="{{ post_url }}" class="merdpos-admin-form merdpos-admin-form--wide">
          <input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="entity_action" value="save_employee"><input type="hidden" name="id" value="{{ employee.id }}">
          <label><span>Full name</span><input name="full_name" maxlength="190" value="{{ employee.full_name }}" required></label>
          <label><span>User ID</span><input name="user_id" inputmode="numeric" maxlength="32" value="{{ employee.user_id }}" required></label>
          <label><span>Role</span><select name="client_role_id">{% for role in roles %}<option value="{{ role.id }}"{{ role.id == employee.client_role_id ? ' selected' : '' }}>{{ role.role_label }} &middot; LOA {{ role.authority_level }}</option>{% endfor %}</select></label>
          <label><span>Status</span><select name="status"{{ employee.self ? ' disabled' : '' }}><option value="active"{{ employee.status == 'active' ? ' selected' : '' }}>Active</option><option value="inactive"{{ employee.status == 'inactive' ? ' selected' : '' }}>Inactive</option></select>{% if employee.self %}<input type="hidden" name="status" value="active">{% endif %}</label>
          <label><span>Store access</span><select name="store_access_mode" data-store-mode><option value="all"{{ employee.store_access_mode == 'all' ? ' selected' : '' }}>All stores</option><option value="selected"{{ employee.store_access_mode == 'selected' ? ' selected' : '' }}>Selected stores</option></select></label>
          <label class="is-wide"><span>Allowed stores</span><select name="store_ids[]" multiple size="{{ stores|length > 4 ? 4 : (stores|length > 0 ? stores|length : 1) }}" data-store-list>{% for store in stores %}{% if store.status == 'active' %}<option value="{{ store.id }}"{{ store.id in employee.assigned_store_ids|default([]) ? ' selected' : '' }}>{{ store.store_name }}</option>{% endif %}{% endfor %}</select></label>
          {% if permissions['workforce.payrates.manage']|default(false) %}<label><span>Hourly rate</span><input name="hourly_rate" inputmode="decimal" value="{{ employee.hourly_rate|default('0.00') }}" required></label><label><span>Rate effective</span><input type="date" name="rate_effective_date" value="{{ employee.next_rate.effective_from|default(directory.today) }}" required></label>{% endif %}
          {% if permissions['workforce.credentials.reset']|default(false) %}<label><span>Reset password</span><input type="password" name="new_password" inputmode="numeric" minlength="4" maxlength="20" pattern="[0-9]+" autocomplete="new-password" placeholder="Leave blank to keep"></label>{% endif %}
          <div class="merdpos-admin-form-actions"><button type="submit">Save employee</button></div>
        </form>
        {% else %}<div class="merdpos-admin-readonly">This employee is above your current authority level.</div>{% endif %}
      </details>
      {% else %}<div class="merdpos-admin-empty">No workforce records are available in this client context.</div>{% endfor %}
    </div>
  </section>

  <section class="merdpos-admin-section" data-admin-panel="roles">
    <div class="merdpos-admin-section-head">
      <div><p>AUTHORITY</p><h2>Roles</h2><span>Create and maintain assignable roles. Workforce assigns these roles to employees.</span></div>
      <div class="merdpos-admin-head-actions"><span class="merdpos-admin-permission">roles.manage</span></div>
    </div>
    {% if can_manage_roles %}
    <div class="merdpos-admin-role-note"><strong>LOA {{ actor_authority }}</strong><span>You can manage custom roles at or below your own authority. System-role authority and permission thresholds remain DEV-governed.</span></div>
    <details class="merdpos-admin-editor merdpos-admin-editor--new">
      <summary><strong>New role</strong><span>Create an assignable custom role</span></summary>
      <form method="post" action="{{ post_url }}" class="merdpos-admin-form">
        <input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="entity_action" value="create_role">
        <label><span>Role name</span><input name="role_label" maxlength="80" required></label>
        <label><span>Authority level (LOA)</span><input type="number" name="authority_level" min="1" max="{{ actor_authority > 99 ? 99 : actor_authority }}" value="{{ actor_authority > 50 ? 50 : actor_authority }}" required></label>
        <div class="merdpos-admin-form-actions"><button type="submit">Create role</button></div>
      </form>
    </details>
    <div class="merdpos-admin-list">
      {% for role in authority_roles %}
      <details class="merdpos-admin-editor" data-role-row="{{ role.id }}">
        <summary><div><strong>{{ role.role_label }}</strong><span>{{ role.role_key }} &middot; {{ role.is_system ? 'System' : 'Custom' }}</span></div><div class="merdpos-admin-summary-meta"><b>LOA {{ role.authority_level }}</b><span>{{ role.employee_count }} assigned</span></div></summary>
        {% if role.editable %}
        <form method="post" action="{{ post_url }}" class="merdpos-admin-form">
          <input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="entity_action" value="save_role"><input type="hidden" name="role_id" value="{{ role.id }}">
          <label><span>Role name</span><input name="role_label" maxlength="80" value="{{ role.role_label }}"{{ role.is_system ? ' readonly' : '' }} required></label>
          <label><span>Authority level (LOA)</span><input type="number" name="authority_level" min="1" max="{{ role_state.can_manage_system_roles|default(false) ? 99 : (actor_authority > 99 ? 99 : actor_authority) }}" value="{{ role.authority_level }}" required></label>
          <div class="merdpos-admin-form-actions"><button type="submit">Save role</button>{% if role.deletable %}<button type="submit" name="entity_action" value="delete_role" class="is-danger" onclick="return confirm('Delete this unassigned role?')">Delete role</button>{% endif %}</div>
        </form>
        {% else %}<div class="merdpos-admin-readonly">{{ role.role_key == 'DEV' ? 'DEV authority is fixed at 1000.' : 'This role is outside your delegated role-management boundary.' }}</div>{% endif %}
      </details>
      {% else %}<div class="merdpos-admin-empty">No roles are available in this client context.</div>{% endfor %}
    </div>
    {% if can_manage_permissions %}
    <details class="merdpos-admin-editor merdpos-admin-role-policy">
      <summary><strong>Permission thresholds</strong><span>DEV-only security policy</span></summary>
      <form method="post" action="{{ post_url }}" class="merdpos-admin-permission-form">
        <input type="hidden" name="form_token" value="{{ form_token }}"><input type="hidden" name="entity_action" value="save_role_permissions">
        <p>Access is granted when role LOA meets the permission minimum. DEV-only permissions stay fixed at LOA 1000.</p>
        <div class="merdpos-admin-permission-grid">{% for permission in permission_rules %}<label><span><strong>{{ permission.label }}</strong><small>{{ permission.category }} &middot; {{ permission.permission_key }}</small></span><input type="number" name="levels[{{ permission.permission_key }}]" min="1" max="1000" value="{{ permission.min_authority_level }}"{{ permission.dev_only ? ' readonly' : '' }}></label>{% endfor %}</div>
        <div class="merdpos-admin-form-actions"><button type="submit">Save permission thresholds</button></div>
      </form>
    </details>
    {% endif %}
    {% else %}<div class="merdpos-admin-empty">Your role does not have role-management authority.</div>{% endif %}
  </section>

  {% if gateway_status != 'ok' %}
    <div class="merdpos-admin-error">MERDPOS administration data is temporarily unavailable. No direct database fallback was used.</div>
  {% endif %}

  {% if can_manage_legacy %}
  <dialog class="merdpos-legacy-dialog" data-legacy-dialog aria-labelledby="merdposLegacyTitle">
    <div class="merdpos-legacy-dialog-head">
      <div><h2 id="merdposLegacyTitle" data-legacy-title>Legacy migration</h2><p>Controlled Google &rarr; staging &rarr; validation &rarr; MERDPOS SQL migration.</p></div>
      <button type="button" class="merdpos-legacy-close" data-legacy-close aria-label="Close">&times;</button>
    </div>
    <div class="merdpos-legacy-body" data-legacy-body><div class="merdpos-admin-empty">Loading migration state&hellip;</div></div>
  </dialog>
  {% endif %}

  <footer class="merdpos-admin-footer"><strong>Signed write boundary</strong><span>Drupal submits only whitelisted fields. MERDPOS re-resolves the actor, role, LOA, permissions, validation and audit trail before mutation.</span></footer>
</section>
