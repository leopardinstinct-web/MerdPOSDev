<?php

declare(strict_types=1);

/**
 * @file
 * Theme hooks for the MERDPOS Drupal application.
 */

/**
 * Implements hook_theme().
 */
function merdpos_core_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'merdpos_surface' => [
      'variables' => [
        'surface' => [],
      ],
      'template' => 'merdpos-surface',
    ],
    'merdpos_dashboard' => [
      'variables' => ['surface' => [], 'charts' => []],
      'template' => 'merdpos-dashboard',
    ],
    'merdpos_operations' => [
      'variables' => ['surface' => [], 'charts' => []],
      'template' => 'merdpos-operations',
    ],
    'merdpos_administration' => [
      'variables' => [
        'directory' => [], 'clients' => [], 'can_manage_clients' => false,
        'can_select_client' => false, 'selectable_clients' => [],
        'selected_client_id' => 0, 'selected_client' => [], 'form_token' => '',
        'gateway_status' => 'unavailable',
      ],
      'template' => 'merdpos-administration',
    ],
    'merdpos_reports' => [
      'variables' => ['surface' => [], 'charts' => [], 'export_url' => ''],
      'template' => 'merdpos-reports',
    ],
    'merdpos_finance' => [
      'variables' => ['surface' => [], 'charts' => []],
      'template' => 'merdpos-finance',
    ],
    'merdpos_dev' => [
      'variables' => ['surface' => [], 'charts' => [], 'release' => [], 'local_runtime' => []],
      'template' => 'merdpos-dev',
    ],
  ];
}
