<?php

declare(strict_types=1);

use Drupal\Core\Url;
use Drupal\user\Entity\Role;

/**
 * Prepares the Git-owned MERDPOS application shell and login surface.
 */
function merdpos_app_preprocess_page(array &$variables): void {
  $account = \Drupal::currentUser();
  $route_name = (string) \Drupal::routeMatch()->getRouteName();
  $variables['merdpos_is_login'] = $route_name === 'user.login';
  $variables['merdpos_profile'] = NULL;
  $variables['merdpos_pending_disputes'] = 0;
  $variables['merdpos_permission_map'] = [];
  $variables['merdpos_section_tabs'] = [];
  $variables['merdpos_dev_url'] = '';
  $variables['merdpos_can_change_password'] = false;
  $variables['merdpos_password_url'] = '';
  $variables['merdpos_password_token'] = '';
  $variables['merdpos_password_return'] = '';
  $variables['merdpos_client_context_available'] = false;
  $variables['merdpos_can_select_client'] = false;
  $variables['merdpos_clients'] = [];
  $variables['merdpos_active_client_id'] = 0;
  $variables['merdpos_active_client'] = [];
  $variables['merdpos_working_client_url'] = '';
  $variables['merdpos_working_client_token'] = '';
  $variables['merdpos_can_timesheet_sync'] = false;
  $variables['merdpos_timesheet_sync_url'] = '';
  $variables['merdpos_timesheet_sync_token'] = '';

  if ($variables['merdpos_is_login']) {
    $variables['merdpos_user_name'] = '';
    $variables['merdpos_role_labels'] = [];
    $variables['merdpos_nav'] = [];
    $variables['merdpos_active_section'] = 'login';
    $variables['merdpos_active_label'] = 'Sign in';
    return;
  }

  if ($account->isAuthenticated()) {
    try {
      $profile = \Drupal::service('merdpos_core.identity_manager')->profile((int) $account->id());
      if (is_array($profile)) $variables['merdpos_profile'] = $profile;
    }
    catch (Throwable) {}
  }

  if ($account->isAuthenticated()) {
    try {
      $contextResult = \Drupal::service('merdpos_core.portal_gateway')->call('client_context', 'GET');
      $contextPayload = is_array($contextResult['payload'] ?? NULL) ? $contextResult['payload'] : [];
      if (($contextResult['status'] ?? '') === 'ok' && !empty($contextPayload['success'])) {
        $variables['merdpos_client_context_available'] = true;
        $variables['merdpos_can_select_client'] = !empty($contextPayload['can_select_client']);
        $variables['merdpos_clients'] = is_array($contextPayload['clients'] ?? NULL) ? $contextPayload['clients'] : [];
        $variables['merdpos_active_client_id'] = max(0, (int) ($contextPayload['active_client_id'] ?? 0));
        $variables['merdpos_active_client'] = is_array($contextPayload['client'] ?? NULL) ? $contextPayload['client'] : [];
        if ($variables['merdpos_can_select_client']) {
          $variables['merdpos_working_client_url'] = Url::fromRoute('merdpos_core.working_client')->toString();
          $variables['merdpos_working_client_token'] = \Drupal::service('csrf_token')->get('merdpos_working_client_v1');
          $variables['merdpos_can_timesheet_sync'] = $variables['merdpos_active_client_id'] > 0;
          $variables['merdpos_timesheet_sync_url'] = Url::fromRoute('merdpos_core.timesheet_google_sync')->toString();
          $variables['merdpos_timesheet_sync_token'] = \Drupal::service('csrf_token')->get('merdpos_timesheet_google_sync_v1');
        }
      }
    }
    catch (Throwable) {}
  }

  if ($account->isAuthenticated()) {
    try {
      $state = \Drupal::service('merdpos_core.portal_gateway')->call('beta_state', 'GET');
      $payload = is_array($state['payload'] ?? NULL) ? $state['payload'] : [];
      $variables['merdpos_permission_map'] = is_array($payload['permissions'] ?? NULL) ? $payload['permissions'] : [];
      $variables['merdpos_can_change_password'] = !empty($variables['merdpos_permission_map']['password.change_own']);
      if ($variables['merdpos_can_change_password']) {
        $variables['merdpos_password_url'] = Url::fromRoute('merdpos_core.change_password')->toString();
        $variables['merdpos_password_token'] = \Drupal::service('csrf_token')->get('merdpos_change_password_v1');
        $variables['merdpos_password_return'] = \Drupal::request()->getRequestUri();
      }
      foreach (($payload['disputes'] ?? []) as $row) {
        if (!is_array($row)) continue;
        if (in_array(strtolower((string) ($row['status'] ?? '')), ['pending','awaiting_employee'], true)) $variables['merdpos_pending_disputes']++;
      }
    }
    catch (Throwable) {}
  }

  if (is_array($variables['merdpos_profile'])) {
    $profile = $variables['merdpos_profile'];
    $variables['merdpos_user_name'] = (string) ($profile['full_name'] ?? 'MERDPOS User');
    $variables['merdpos_role_labels'] = [(string) ($profile['role_label'] ?? $profile['role'] ?? 'MERDPOS')];
  }
  else {
    $roles = Role::loadMultiple($account->getRoles());
    $variables['merdpos_user_name'] = $account->getDisplayName();
    $variables['merdpos_role_labels'] = array_values(array_map(
      static fn (Role $role): string => $role->label(),
      $roles,
    ));
  }

  $items = [
    ['key' => 'home', 'label' => 'Home', 'route' => 'merdpos_core.dashboard', 'permission' => 'view merdpos management dashboard'],
    ['key' => 'admin', 'label' => 'Admin', 'route' => 'merdpos_core.administration', 'permission' => 'manage merdpos operations'],
    ['key' => 'finance', 'label' => 'Financials', 'route' => 'merdpos_core.finance', 'permission' => 'access merdpos portal', 'backend_permission'=>'finance.view'],
    ['key' => 'reports', 'label' => 'Timesheets', 'route' => 'merdpos_core.reports', 'permission' => 'access merdpos portal', 'badge' => $variables['merdpos_pending_disputes']],
  ];
  if ($account->hasPermission('access merdpos dev tools')) $variables['merdpos_dev_url'] = Url::fromRoute('merdpos_core.dev')->toString();

  $variables['merdpos_nav'] = [];
  foreach ($items as $item) {
    if (!$account->hasPermission($item['permission'])) continue;
    if (isset($item['backend_permission']) && empty($variables['merdpos_permission_map'][$item['backend_permission']])) continue;
    $item['url'] = Url::fromRoute($item['route'])->toString();
    $item['active'] = $route_name === $item['route'];
    $variables['merdpos_nav'][] = $item;
  }

  $active = array_values(array_filter(
    $variables['merdpos_nav'],
    static fn (array $item): bool => $item['active'],
  ));
  $variables['merdpos_active_section'] = $active[0]['key'] ?? 'home';
  $variables['merdpos_active_label'] = $active[0]['label'] ?? 'Home';

  $perms = $variables['merdpos_permission_map'];
  $requested_tab = trim((string) (\Drupal::request()->query->get('tab') ?? ''));
  if ($route_name === 'merdpos_core.administration') {
    $tabs = [];
    if (!empty($perms['clients.manage'])) {
      $tabs[] = ['key'=>'onboarding','label'=>'Onboard'];
      $tabs[] = ['key'=>'clients','label'=>'Clients'];
    }
    if (!empty($perms['stores.manage'])) $tabs[] = ['key'=>'stores','label'=>'Stores'];
    if (!empty($perms['defaults.manage'])) $tabs[] = ['key'=>'defaults','label'=>'Defaults'];
    if (!empty($perms['workforce.manage'])) $tabs[] = ['key'=>'workforce','label'=>'Workforce'];
    if (!empty($perms['roles.manage'])) $tabs[] = ['key'=>'roles','label'=>'Roles'];
    $keys = array_column($tabs, 'key');
    $active_tab = in_array($requested_tab, $keys, true) ? $requested_tab : ($keys[0] ?? '');
    foreach ($tabs as $tab) {
      $tab['url'] = Url::fromRoute('merdpos_core.administration', [], ['query'=>['tab'=>$tab['key']]])->toString();
      $tab['active'] = $tab['key'] === $active_tab;
      $variables['merdpos_section_tabs'][] = $tab;
    }
  }
}

/**
 * Adds a stable body class for the custom MERDPOS login route.
 */
function merdpos_app_preprocess_html(array &$variables): void {
  if ((string) \Drupal::routeMatch()->getRouteName() === 'user.login') {
    $variables['attributes']['class'][] = 'merdpos-login-route';
  }
}
