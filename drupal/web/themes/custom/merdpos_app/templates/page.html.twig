{% if merdpos_is_login %}
<div class="merdpos-login-scene">
  <label class="merdpos-theme-control merdpos-theme-control--login">
    <span>Theme</span>
    <select data-merdpos-theme aria-label="Color theme">
      <option value="system">System</option>
      <option value="light">Light</option>
      <option value="dark">Dark</option>
    </select>
  </label>
  <main id="main-content" class="merdpos-login-layout" tabindex="-1">
    <section class="merdpos-login-card" aria-labelledby="merdpos-login-title">
      <div class="merdpos-login-brand">
        <img src="{{ base_path ~ directory ~ '/assets/merdpos-logo-approved.png' }}" alt="MERDPOS - Smarter Faster Together">
      </div>
      <p class="merdpos-login-kicker">SECURE WORKSPACE</p>
      <h1 id="merdpos-login-title">Welcome back.</h1>
      <p class="merdpos-login-lead">Sign in to your MERDPOS workspace.</p>
      {{ page.content }}
      <div class="merdpos-login-trust"><span></span>Authoritative MERDPOS identity · Drupal never stores your MERDPOS password</div>
    </section>

    <aside class="merdpos-login-visual" aria-label="MERDPOS workspace preview">
      <div class="merdpos-login-orb merdpos-login-orb--one"></div>
      <div class="merdpos-login-orb merdpos-login-orb--two"></div>
      <div class="merdpos-login-visual-head">
        <span class="merdpos-login-visual-badge">MERDPOS / DRUPAL BETA</span>
        <h2>One identity. Full operational context.</h2>
        <p>Your MERDPOS role, LOA and permissions stay authoritative at the service boundary.</p>
      </div>
      <div class="merdpos-login-capabilities">
        <article><span class="merdpos-login-capability-icon"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><strong>Administration</strong><small>Workforce · Stores</small></article>
        <article><span class="merdpos-login-capability-icon"><svg viewBox="0 0 24 24"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20V7"/></svg></span><strong>Timesheets</strong><small>Shifts · Corrections</small></article>
        <article><span class="merdpos-login-capability-icon"><svg viewBox="0 0 24 24"><path d="M3 7h15a3 3 0 0 1 3 3v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M16 12h5v4h-5a2 2 0 0 1 0-4Z"/><path d="M5 7V5a2 2 0 0 1 2-2h10"/></svg></span><strong>Financials</strong><small>Cash · Ledger</small></article>
        <article><span class="merdpos-login-capability-icon"><svg viewBox="0 0 24 24"><path d="m8 9-4 3 4 3"/><path d="m16 9 4 3-4 3"/><path d="m14 5-4 14"/></svg></span><strong>DEV</strong><small>Platform · Clients</small></article>
      </div>
      <div class="merdpos-login-security-card"><span class="merdpos-login-security-dot"></span><div><strong>Signed service boundary</strong><small>No direct operational database access</small></div></div>
    </aside>
  </main>
</div>
{% else %}
<div class="merdpos-shell-frame" data-active-section="{{ merdpos_active_section }}">
  <header class="merdpos-shell-header">
    <a class="merdpos-shell-brand" href="{{ path('merdpos_core.dashboard') }}" aria-label="MERDPOS Home">
      <img class="merdpos-shell-mark" data-merdpos-shell-brand-image data-light-src="{{ base_path ~ directory ~ '/assets/merdpos-mark.png' }}" data-dark-src="{{ base_path ~ directory ~ '/assets/M-dark-theme.png' }}" src="{{ base_path ~ directory ~ '/assets/merdpos-mark.png' }}" alt="" width="36" height="36">
      <span class="merdpos-shell-brand-copy">
        <img class="merdpos-shell-wordmark" data-merdpos-shell-brand-image data-light-src="{{ base_path ~ directory ~ '/assets/merdpos-wordmark.png' }}" data-dark-src="{{ base_path ~ directory ~ '/assets/MERDPOS-dark-theme.png' }}" src="{{ base_path ~ directory ~ '/assets/merdpos-wordmark.png' }}" alt="MERDPOS">
      </span>
    </a>


    <div class="merdpos-shell-actions">
      <div class="merdpos-account">
      <div class="merdpos-account-pills" aria-label="Working context"><span class="merdpos-account-context-pill" data-merdpos-client-code title="Working client">{{ merdpos_active_client.client_code|default('—') }}</span><span class="merdpos-account-context-pill" data-merdpos-role-pill title="Working role">{{ merdpos_role_labels|last }}</span></div>
      <button class="merdpos-account-trigger" type="button" data-merdpos-account-toggle aria-expanded="false">
        <span class="merdpos-account-avatar" aria-hidden="true">{{ merdpos_user_name|first|upper }}</span>
        <span class="merdpos-account-copy">
          <strong>{{ merdpos_user_name }}</strong>
          <small>{{ merdpos_role_labels|last }}</small>
        </span>
        <span class="merdpos-account-chevron" aria-hidden="true">⌄</span>
      </button>
      <div class="merdpos-account-menu" data-merdpos-account-menu hidden>
        <div class="merdpos-account-menu-head">
          <strong>{{ merdpos_user_name }}</strong>
          <span>{{ merdpos_role_labels|join(' · ') }}</span>
        </div>
        {% if merdpos_client_context_available %}
        <details class="merdpos-account-context" data-merdpos-context-section>
          <summary><span>Working client</span><small>{{ merdpos_active_client.name|default('MERDPOS client') }}</small></summary>
          <div class="merdpos-account-context-row" data-merdpos-working-client-block>
            <span class="merdpos-account-context-label">Working client</span>
            {% if merdpos_can_select_client %}
              <select data-merdpos-working-client data-endpoint="{{ merdpos_working_client_url }}" data-csrf="{{ merdpos_working_client_token }}" aria-label="Select working client">
                {% for client in merdpos_clients %}<option value="{{ client.id }}"{{ client.id == merdpos_active_client_id ? ' selected' : '' }}>{{ client.name }}{% if client.client_code %} · {{ client.client_code }}{% endif %}</option>{% endfor %}
              </select>
            {% else %}<strong>{{ merdpos_active_client.name|default('MERDPOS client') }}</strong>{% endif %}
            {% if merdpos_can_timesheet_sync %}<button class="merdpos-account-timesheet-sync" type="button" data-merdpos-timesheet-sync data-endpoint="{{ merdpos_timesheet_sync_url }}" data-csrf="{{ merdpos_timesheet_sync_token }}" data-client-id="{{ merdpos_active_client_id }}" data-client-name="{{ merdpos_active_client.name|default('Working client') }}" aria-label="Sync Time Sheet from Google" title="Sync Time Sheet"><img src="{{ base_path ~ directory ~ '/assets/restart_alt_48px.svg' }}" alt=""></button>{% endif %}
          </div>
          <span class="merdpos-account-context-notice" data-merdpos-context-notice aria-live="polite"></span>
        </details>
        {% endif %}
        {% if merdpos_can_select_role %}
        {% set merdpos_working_role_label = merdpos_active_role_key == 'DEV' ? 'Developer' : (merdpos_active_role_key|lower|capitalize) %}
        <details class="merdpos-account-context merdpos-account-role-context" data-merdpos-context-section>
          <summary><span>Working Role</span><small>{{ merdpos_working_role_label }}</small></summary>
          <div class="merdpos-account-context-row">
            <span class="merdpos-account-context-label">Working Role</span>
            <select data-merdpos-working-role data-endpoint="{{ merdpos_working_role_url }}" data-csrf="{{ merdpos_working_role_token }}" aria-label="Select Working Role">
              <option value="DEV"{{ merdpos_active_role_key == 'DEV' ? ' selected' : '' }}>Developer</option>
              <option value="ADMIN"{{ merdpos_active_role_key == 'ADMIN' ? ' selected' : '' }}>Admin</option>
              <option value="SUPER"{{ merdpos_active_role_key == 'SUPER' ? ' selected' : '' }}>Super</option>
              <option value="USER"{{ merdpos_active_role_key == 'USER' ? ' selected' : '' }}>User</option>
            </select>
          </div>
        </details>
        {% endif %}
        <button class="merdpos-account-menu-action" type="button" data-merdpos-theme-toggle aria-label="Toggle color theme">
          <svg class="merdpos-account-menu-icon merdpos-theme-icon merdpos-theme-icon--light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg>
          <svg class="merdpos-account-menu-icon merdpos-theme-icon merdpos-theme-icon--dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
          <span data-merdpos-theme-label>Theme</span>
        </button>
        {% if merdpos_can_change_password %}
          <button class="merdpos-account-menu-action" type="button" data-merdpos-password-open><svg class="merdpos-account-menu-icon" viewBox="0 -960 960 960" aria-hidden="true"><path fill="currentColor" d="M420-360h120l-23-129q20-10 31.5-29t11.5-42q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 23 11.5 42t31.5 29l-23 129Zm60 280q-139-35-229.5-159.5T160-516v-244l320-120 320 120v244q0 152-90.5 276.5T480-80Z"/></svg><span>Change password</span></button>
        {% endif %}
        {% if merdpos_dev_url %}<a class="merdpos-account-menu-action" href="{{ merdpos_dev_url }}"><svg class="merdpos-account-menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 9-4 3 4 3"/><path d="m16 9 4 3-4 3"/><path d="m14 5-4 14"/></svg><span>DEV</span></a>{% endif %}
        <a class="merdpos-account-menu-action" href="{{ path('user.logout', {}, {'query': {'destination': path('user.login')}}) }}"><svg class="merdpos-account-menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/><path d="M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5"/></svg><span>Log out</span></a>
      </div>
      </div>
    </div>
  </header>

  {% if merdpos_can_change_password %}
  <dialog class="merdpos-password-dialog" data-merdpos-password-dialog aria-labelledby="merdpos-password-title">
    <form class="merdpos-password-form" method="post" action="{{ merdpos_password_url }}">
      <input type="hidden" name="form_token" value="{{ merdpos_password_token }}">
      <input type="hidden" name="return_url" value="{{ merdpos_password_return }}">
      <header>
        <div><p>ACCOUNT SECURITY</p><h2 id="merdpos-password-title">Change password</h2></div>
        <button type="button" class="merdpos-password-close" data-merdpos-password-close aria-label="Close password dialog">×</button>
      </header>
      <p class="merdpos-password-note">Use your current MERDPOS password. The new password must contain 6–20 digits.</p>
      <label>Current password<input name="current_password" type="password" inputmode="numeric" pattern="[0-9]*" maxlength="20" required autocomplete="current-password"></label>
      <label>New password<input name="new_password" type="password" inputmode="numeric" pattern="[0-9]{6,20}" minlength="6" maxlength="20" required autocomplete="new-password"></label>
      <label>Confirm new password<input name="confirm_password" type="password" inputmode="numeric" pattern="[0-9]{6,20}" minlength="6" maxlength="20" required autocomplete="new-password"></label>
      <div class="merdpos-password-actions">
        <button type="button" class="merdpos-btn" data-merdpos-password-close>Cancel</button>
        <button type="submit" class="merdpos-btn merdpos-btn--primary">Change password</button>
      </div>
    </form>
  </dialog>
  {% endif %}

  {% if merdpos_section_tabs|default([]) %}
  <nav class="merdpos-section-tabs merdpos-shell-section-tabs{{ merdpos_active_section == 'admin' ? ' merdpos-admin-tabs' : '' }}" aria-label="{{ merdpos_active_label }} sections">
    {% for tab in merdpos_section_tabs %}
      <a href="{{ tab.url }}" class="{{ tab.active ? 'is-active' : '' }}"{{ tab.active ? ' aria-current="page"' : '' }}>{{ tab.label }}</a>
    {% endfor %}
  </nav>
  {% endif %}

  <main id="main-content" class="merdpos-shell-workspace" tabindex="-1">
    {{ page.content }}
  </main>

  <nav class="merdpos-bottom-nav" aria-label="MERDPOS primary navigation">
    {% for item in merdpos_nav %}
      <a class="merdpos-bottom-nav-item{{ item.active ? ' is-active' : '' }}"
         href="{{ item.url }}"
         data-nav-section="{{ item.key }}"
         {% if item.active %}aria-current="page"{% endif %}>
        <span class="merdpos-bottom-nav-icon" aria-hidden="true">
          {% if item.key == 'home' %}
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
          {% elseif item.key == 'operations' %}
            <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          {% elseif item.key == 'admin' %}
            <svg viewBox="0 0 24 24"><path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><path d="M1 14h6"/><path d="M9 8h6"/><path d="M17 16h6"/></svg>
          {% elseif item.key == 'reports' %}
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          {% elseif item.key == 'finance' %}
            <svg viewBox="0 0 24 24"><path d="M3 7h15a3 3 0 0 1 3 3v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M16 12h5v4h-5a2 2 0 0 1 0-4Z"/><path d="M5 7V5a2 2 0 0 1 2-2h10"/></svg>
          {% else %}
            <svg viewBox="0 0 24 24"><path d="m8 9-4 3 4 3"/><path d="m16 9 4 3-4 3"/><path d="m14 5-4 14"/></svg>
          {% endif %}
        </span>
        <span class="merdpos-bottom-nav-label">{{ item.label }}</span>
        {% if item.badge|default(0) > 0 %}<span class="merdpos-bottom-nav-badge" aria-label="{{ item.badge }} open disputes">{{ item.badge > 99 ? '99+' : item.badge }}</span>{% endif %}
      </a>
    {% endfor %}
  </nav>
</div>
{% endif %}
