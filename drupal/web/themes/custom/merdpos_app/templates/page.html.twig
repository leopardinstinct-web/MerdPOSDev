{% if merdpos_is_login %}
<div class="merdpos-login-scene">
  <label class="merdpos-theme-control merdpos-theme-control--login">
    <span>Theme</span>
    <select data-merdpos-theme aria-label="Color theme">
      <option value="system">System</option>
      <option value="light">Light</option>
      <option value="dark">Dark</option>
    </select>
  </label>
  <main id="main-content" class="merdpos-login-layout" tabindex="-1">
    <section class="merdpos-login-card" aria-labelledby="merdpos-login-title">
      <div class="merdpos-login-brand">
        <img src="{{ base_path ~ directory ~ '/assets/merdpos-logo-approved.png' }}" alt="MERDPOS - Smarter Faster Together">
      </div>
      <p class="merdpos-login-kicker">SECURE WORKSPACE</p>
      <h1 id="merdpos-login-title">Welcome back.</h1>
      <p class="merdpos-login-lead">Sign in to your MERDPOS workspace.</p>
      {{ page.content }}
      <div class="merdpos-login-trust"><span></span>Authoritative MERDPOS identity · Drupal never stores your MERDPOS password</div>
    </section>

    <aside class="merdpos-login-visual" aria-label="MERDPOS workspace preview">
      <div class="merdpos-login-orb merdpos-login-orb--one"></div>
      <div class="merdpos-login-orb merdpos-login-orb--two"></div>
      <div class="merdpos-login-visual-head">
        <span class="merdpos-login-visual-badge">MERDPOS / DRUPAL BETA</span>
        <h2>One identity. Full operational context.</h2>
        <p>Your MERDPOS role, LOA and permissions stay authoritative at the service boundary.</p>
      </div>
      <div class="merdpos-login-capabilities">
        <article><span class="merdpos-login-capability-icon"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><strong>Operations</strong><small>Workforce · Stores</small></article>
        <article><span class="merdpos-login-capability-icon"><svg viewBox="0 0 24 24"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20V7"/></svg></span><strong>Reports</strong><small>Timesheets · Disputes</small></article>
        <article><span class="merdpos-login-capability-icon"><svg viewBox="0 0 24 24"><path d="M3 7h15a3 3 0 0 1 3 3v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M16 12h5v4h-5a2 2 0 0 1 0-4Z"/><path d="M5 7V5a2 2 0 0 1 2-2h10"/></svg></span><strong>Finance</strong><small>Cash · Ledger</small></article>
        <article><span class="merdpos-login-capability-icon"><svg viewBox="0 0 24 24"><path d="m8 9-4 3 4 3"/><path d="m16 9 4 3-4 3"/><path d="m14 5-4 14"/></svg></span><strong>DEV</strong><small>Platform · Clients</small></article>
      </div>
      <div class="merdpos-login-security-card"><span class="merdpos-login-security-dot"></span><div><strong>Signed service boundary</strong><small>No direct operational database access</small></div></div>
    </aside>
  </main>
</div>
{% else %}
<div class="merdpos-shell-frame" data-active-section="{{ merdpos_active_section }}">
  <header class="merdpos-shell-header">
    <a class="merdpos-shell-brand" href="{{ path('merdpos_core.dashboard') }}" aria-label="MERDPOS Home">
      <img class="merdpos-shell-mark" src="{{ base_path ~ directory ~ '/assets/M_Icon_v2.svg' }}" alt="" width="36" height="36">
      <span class="merdpos-shell-brand-copy">
        <img class="merdpos-shell-wordmark" src="{{ base_path ~ directory ~ '/assets/merdpos-wordmark.png' }}" alt="MERDPOS">
        <small>Drupal Beta</small>
      </span>
    </a>

    <div class="merdpos-shell-context" aria-label="Current section">
      <span class="merdpos-shell-context-dot" aria-hidden="true"></span>
      <span>{{ merdpos_active_label }}</span>
    </div>

    <div class="merdpos-shell-actions">
      <label class="merdpos-theme-control">
        <span>Theme</span>
        <select data-merdpos-theme aria-label="Color theme">
          <option value="system">System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </label>

      <div class="merdpos-account">
      <button class="merdpos-account-trigger" type="button" data-merdpos-account-toggle aria-expanded="false">
        <span class="merdpos-account-avatar" aria-hidden="true">{{ merdpos_user_name|first|upper }}</span>
        <span class="merdpos-account-copy">
          <strong>{{ merdpos_user_name }}</strong>
          <small>{{ merdpos_role_labels|last }}</small>
        </span>
        <span class="merdpos-account-chevron" aria-hidden="true">⌄</span>
      </button>
      <div class="merdpos-account-menu" data-merdpos-account-menu hidden>
        <div class="merdpos-account-menu-head">
          <strong>{{ merdpos_user_name }}</strong>
          <span>{{ merdpos_role_labels|join(' · ') }}</span>
        </div>
        {% if merdpos_profile %}<span class="merdpos-account-id">MERDPOS ID {{ merdpos_profile.user_id }}</span>{% endif %}
        <a href="{{ path('user.logout', {}, {'query': {'destination': path('user.login')}}) }}">Log out</a>
      </div>
      </div>
    </div>
  </header>

  <div class="merdpos-context-strip" aria-label="Section context">
    {% if merdpos_active_label == 'Disputes' %}
      <span class="merdpos-context-item is-current">Disputes</span>
      <span class="merdpos-context-item is-live">Operations</span>
      <span class="merdpos-context-item is-live">Timesheets</span>
    {% elseif merdpos_active_section == 'operations' %}
      <span class="merdpos-context-item is-current">Operations</span>
      <span class="merdpos-context-item is-live">Workforce</span>
      <span class="merdpos-context-item is-live">Stores</span>
      <span class="merdpos-context-item is-live">Disputes</span>
    {% elseif merdpos_active_section == 'admin' %}
      <span class="merdpos-context-item is-current">Administration</span>
      <span class="merdpos-context-item is-live">Clients</span>
      <span class="merdpos-context-item is-live">Stores</span>
      <span class="merdpos-context-item is-live">Workforce</span>
    {% elseif merdpos_active_section == 'reports' %}
      <span class="merdpos-context-item is-current">Reports</span>
      <span class="merdpos-context-item is-live">Timesheets</span>
      <span class="merdpos-context-item is-live">Disputes</span>
    {% elseif merdpos_active_section == 'finance' %}
      <span class="merdpos-context-item is-current">Finance</span>
      <span class="merdpos-context-item is-live">Store cash</span>
      <span class="merdpos-context-item is-live">Ledger</span>
    {% elseif merdpos_active_section == 'dev' %}
      <span class="merdpos-context-item is-current">DEV</span>
      <span class="merdpos-context-item is-live">Platform</span>
      <span class="merdpos-context-item is-live">Clients</span>
    {% else %}
      <span class="merdpos-context-item is-current">Dashboard</span>
    {% endif %}
    <span class="merdpos-context-state">Signed MERDPOS data</span>
  </div>

  <main id="main-content" class="merdpos-shell-workspace" tabindex="-1">
    {{ page.content }}
  </main>

  <nav class="merdpos-bottom-nav" aria-label="MERDPOS primary navigation">
    {% for item in merdpos_nav %}
      <a class="merdpos-bottom-nav-item{{ item.active ? ' is-active' : '' }}"
         href="{{ item.url }}"
         data-nav-section="{{ item.key }}"
         {% if item.active %}aria-current="page"{% endif %}>
        <span class="merdpos-bottom-nav-icon" aria-hidden="true">
          {% if item.key == 'home' %}
            <svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-6h6v6"/></svg>
          {% elseif item.key == 'operations' %}
            <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          {% elseif item.key == 'admin' %}
            <svg viewBox="0 0 24 24"><path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><path d="M1 14h6"/><path d="M9 8h6"/><path d="M17 16h6"/></svg>
          {% elseif item.key == 'reports' %}
            <svg viewBox="0 0 24 24"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20V7"/></svg>
          {% elseif item.key == 'finance' %}
            <svg viewBox="0 0 24 24"><path d="M3 7h15a3 3 0 0 1 3 3v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M16 12h5v4h-5a2 2 0 0 1 0-4Z"/><path d="M5 7V5a2 2 0 0 1 2-2h10"/></svg>
          {% else %}
            <svg viewBox="0 0 24 24"><path d="m8 9-4 3 4 3"/><path d="m16 9 4 3-4 3"/><path d="m14 5-4 14"/></svg>
          {% endif %}
        </span>
        <span class="merdpos-bottom-nav-label">{{ item.label }}</span>
        {% if item.badge|default(0) > 0 %}<span class="merdpos-bottom-nav-badge" aria-label="{{ item.badge }} open disputes">{{ item.badge > 99 ? '99+' : item.badge }}</span>{% endif %}
      </a>
    {% endfor %}
  </nav>
</div>
{% endif %}
