DirectoryIndex index.php
Options -Indexes

# Shared UI-contract assets change cross-portal behavior and must not remain
# stale behind a browser cache after deployment. `no-cache` still permits local
# caching but requires revalidation; feature/static assets keep normal caching.
<IfModule mod_headers.c>
  <FilesMatch "^(management\.js|minimal-controls\.js|minimal-controls\.css|ui-standard\.css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
